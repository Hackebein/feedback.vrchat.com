      "spam": false,
      "statusChangeID": null,
      "value": "1+ \n\nIf individuals refrain from verifying when VRC employs a system like this, perhaps a better solution will be developed in the future. Providing feedback is one thing, but we can also choose to decline verification until a safe and effective system is established.",
      "viewerReactions": null,
      "voteID": null
    }
