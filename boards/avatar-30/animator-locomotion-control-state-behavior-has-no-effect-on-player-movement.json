      "spam": false,
      "statusChangeID": null,
      "value": "@{65bcae97e785ece63744ee15|full_name} This is inconsistent with what the documentation claims the component does, and used to do.\n\nAlso, tested initially in desktop where locomotion animation toggle does not apply, AND later on in 6 point VR, and I keep my locomotion animations enabled anyhow. \n\nThe documented purpose of this component is not to disable the walking animations, but to disable movement *itself* entirely, as if the avatar/user is seated in a chair etc.",
      "viewerReactions": null,
      "voteID": null
    },
