        "avatarURL": "https://canny-assets.io/images/759db336105189dc7ca779c13443ce0f.png",
        "created": "2020-02-19T02:48:52.222Z",
        "name": "anatawa12",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5ed571497ee72a2434704a15",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-10-24T04:20:15.726Z",
      "deleted": false,
      "deletedAt": null,
      "fileURLs": [],
