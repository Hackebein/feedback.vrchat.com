      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": "68fafe504628abf0288a4483",
      "pinned": false,
      "postDeleted": false,
      "postID": "68e8330a873a14425bb29cf1",
      "private": false,
