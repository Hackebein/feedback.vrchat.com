      "spam": false,
      "statusChangeID": null,
      "value": "@{5adfa711a8ca626f7bf243ae|full_name}: Doing more testing proves you right. Disabling the execution order should disable all the components that it was controlling. However, disabling the execution order in game does not follow this rule, it acts as though you've disabled one of the two active execution orders. Also, if you duplicate the execution order in editor, it will replicate the behavior that occurs in game. Maybe the execution order the devs add in game grabs all FIK components on the avatar for some reason?",
      "viewerReactions": null
    }
