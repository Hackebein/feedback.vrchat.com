      "statusChangeID": null,
      "value": "I can confirm this, if you have non-zero default blend shape values on your mesh, it is not reset correctly for remote players after it was animated.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5f961c80661fad3f4810ed7a",
      "author": {
        "_id": "5c1475afb7ce126e9e0e3a39",
        "alias": "Wineberry Leopard",
        "aliasID": "65c26da3ed6eefce4c4d098e",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/075321cd63d227959c77856a77d84c1b.png",
        "created": "2018-12-15T03:31:59.071Z",
        "name": "bd_",
        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "5ed571497ee72a2434704a15",
      "companyID": "58c62e995865713647a7115d",
      "created": "2020-10-26T00:46:56.311Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [
        "https://canny.io/images/50b9c8daff64b1023db270da40b22d2a.jpg"
      ],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
