      "statusChangeID": null,
      "value": "It's kind of a hack, but you can check for TrackingType > 2. On av3 humanoid avatars TrackingType will never go below 3. So you know that if it is below 3 then the parameters haven't loaded yet.",
      "viewerReactions": null,
      "voteID": null
    },
