      "spam": false,
      "statusChangeID": null,
      "value": "Side note, this isn’t enough if you’re trying to execute a tracking control behavior on startup. For that you need to wait for TrackingType > 2 and then use a parameter driver to set a local parameter, that you can then use for the transition condition to the state with the tracking control behavior.",
      "viewerReactions": null,
      "voteID": null
