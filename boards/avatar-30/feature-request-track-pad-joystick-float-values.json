      "spam": false,
      "statusChangeID": null,
      "value": "Yeah this would be useful for me. I'd like to get an Index, but I have Repetitive Strain Injuries that prevent me from making advanced gestures with my fingers. An Index would be nice to let me rest my fingers (due to how its fastened around the hand, I wouldn't have to constantly grip it), and being able to use the trackpad for gestures would be a godsend for me and people with my condition.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "60c19631d65bf13624ddfab0",
      "author": {
        "_id": "5f465dd8d9b7356021eb6b52",
        "alias": "Brief Walrus",
        "aliasID": "65c2a1fced6eefce4c5e894b",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/f25fd5bf6200b368cb65dddbc64868e4.png",
        "created": "2020-08-26T13:04:24.130Z",
        "name": "Spectral Owl",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5ed571497ee72a2434704a15",
      "companyID": "58c62e995865713647a7115d",
      "created": "2021-06-10T04:33:53.778Z",
