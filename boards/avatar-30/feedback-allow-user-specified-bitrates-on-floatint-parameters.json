      "spam": false,
      "statusChangeID": null,
      "value": "This is really needed. Right now the only ways to get around this are to have toggles disable each other with parameter drivers, or to convert your float or int to boolean encoded binary on the local side and decode it back to decimal on the remote side.",
      "viewerReactions": null,
      "voteID": null
