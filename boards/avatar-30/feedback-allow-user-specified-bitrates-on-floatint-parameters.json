      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This would be a game changer. No longer would we need to manually encode and decode bits in the animator (which can be heavy on performance btw) just to save some synced parameter space. Face tracking would especially benefit from this.\n\nIt would also be wonderful if we could use this for integers bigger than 8 bits as well",
      "viewerReactions": null,
      "voteID": null
    }
