      "authorID": null,
      "boardID": "5ed571497ee72a2434704a15",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-02-17T02:55:47.921Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
