      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{5b4eb6697a870c3a5c2b0ca5|full_name}: I think that you worry too much because similar hacks can be implemented by shader tricks, without this feature.\nIf the problem is this feature makes it a snap to implement a camera-avoider, we can avoid the problem by not updating these parameters for remote players' avatars.",
      "viewerReactions": null,
      "voteID": null
