      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This is a very easy assumption.\n\nIf you have an Avatar with 69,999 triangles and max out all other categories, you still will be rated as \"Good\".\n\nIf you now have an Avatar with 70,001 triangles, you get the very poor rating. Even if your other categories are in the \" Excellent \" region.\n\nWhich one of these avatars will now have a bigger impact on performance? Yes, the one with the \"better\" rating.",
      "viewerReactions": null,
      "voteID": null
    },
