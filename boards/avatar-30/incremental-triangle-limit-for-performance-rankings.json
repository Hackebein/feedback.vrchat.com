        "avatarURL": "https://canny-assets.io/images/c6e6b2eccf2fcc3355cf1b1085e933e1.png",
        "created": "2022-07-26T17:54:23.853Z",
        "name": "Krace",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5ed571497ee72a2434704a15",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-08-24T15:26:02.299Z",
      "deleted": false,
      "deletedAt": null,
      "fileURLs": [],
      "files": [],
