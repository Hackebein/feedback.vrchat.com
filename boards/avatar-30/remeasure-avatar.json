      "statusChangeID": null,
      "value": "For many people who have multiple size versions of their avatars, we'd be able to delete them all and save on the storage overhead of your content servers. This seems like a no-brainer to me.",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "627be424c4e319529ca150c4",
      "author": {
        "_id": "5f71e194626ff47d20bfb43b",
        "alias": "Eggshell Raven",
        "aliasID": "65c26da3ed6eefce4c4d0999",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/bb77447f620e51b3c5a435caf7a79a0a.png",
        "created": "2020-09-28T13:13:56.767Z",
        "name": "knah",
        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "5ed571497ee72a2434704a15",
      "companyID": "58c62e995865713647a7115d",
      "created": "2022-05-11T16:28:20.118Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
