      "statusChangeID": null,
      "value": "@{5f2e0a4e8464150716ffd322|full_name} This isn't a native feature, Unity does not allow copying behavior states. If you make a fresh project without any community tools you'll notice the option does not exist.",
      "viewerReactions": null,
      "voteID": null
    }
