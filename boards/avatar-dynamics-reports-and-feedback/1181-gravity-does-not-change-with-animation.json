      "spam": false,
      "statusChangeID": null,
      "value": "Yeah you cannot animate any Phys Bone values. The workaround I found is disabling the Phys bone script in the first key frame and then applying your changes that you want to the script and at the last key frame you enable the script again.",
      "viewerReactions": null,
      "voteID": null
    },
