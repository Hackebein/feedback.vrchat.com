      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Since the parent constraints I used were set to the head bone this may be related to other issues where physbones stop working when they're scaled down.\nhttps://feedback.vrchat.com/avatar-dynamics-reports-and-feedback \nThe method that VRChat uses to \"hide\" heads from first person point-of-view is to scale them down, not make them invisible, so it would make sense. Will continue testing.",
      "viewerReactions": null,
      "voteID": null
    },
