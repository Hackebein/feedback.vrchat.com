      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{5f2e0a4e8464150716ffd322|full_name}: Ferret avatars are older than SDK3, so it isn't a quick fix for most as they use SDK2. Am hoping converted bones have IsAnimated enabled by default as that was the default behavior of Dynamic Bones.",
      "viewerReactions": null
    },
