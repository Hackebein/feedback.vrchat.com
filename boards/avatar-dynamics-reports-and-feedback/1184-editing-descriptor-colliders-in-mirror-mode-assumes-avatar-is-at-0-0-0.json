        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "61ae60302a0c8153e557fd42",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-01-13T00:25:27.736Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "62377c6d5c1ba8528cf7d0ca",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It seems that only hand and foot colliders are affected, finger colliders are mirrored correctly even when the avatar is not at the origin.\n\nThe mirror center seems to be re-calculated when clicking Edit / Done, moving the avatar and moving colliders in edit mode will keep the last changed mirror center with respective to the avatar. (i.e., moving avatar during edit mode will also move the mirror center along with the avatar, until clicking Done).",
      "viewerReactions": null,
      "voteID": null
    }
