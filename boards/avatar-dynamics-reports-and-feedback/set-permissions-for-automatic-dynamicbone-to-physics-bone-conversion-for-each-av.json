      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Related:\n- [［1184］ Add Sphere Collision Type for PhysBones  ](https://feedback.vrchat.com/open-beta/p/1184-add-sphere-collision-type-for-physbones)\n- [［1181］ Add option to ignore collisions with root, for better DB conversion](https://feedback.vrchat.com/open-beta/p/1181-add-option-to-ignore-collisions-with-root-for-better-db-conversion)\n- [［1181］ DB's \"Inert\" VS PB's \"Immobile\"](https://feedback.vrchat.com/open-beta/p/1181-dbs-inert-vs-pbs-immobile)",
      "viewerReactions": null,
