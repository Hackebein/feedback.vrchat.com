      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Hello.\nI was suffering from similar symptoms, but after turning off Vertical Sync, I can now play videos.\nThank you very much.\nThe following is my PC environment.\nOS:Windows10\nCPU:RYZEN9 5900X\nGPU:RTX 3070\nRAM:32GB",
      "viewerReactions": null
