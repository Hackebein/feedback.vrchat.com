      "mergeID": null,
      "parentID": "616ec4f12028400b7d709795",
      "pinned": false,
      "postDeleted": false,
      "postID": "616dd5512028400b7d6af326",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{5a3c5fa04a8da67427803b3e|full_name}: I think it's best to compute the spawn position in playspace coordinates (ie, real-world distances) and convert back to unity world coordinates. Not sure how easy it is to get the coefficients for that transformation, of course.\nOnce you do so, you can enforce that the distance from the viewpoint is far enough to avoid awkward problems - or to be more precise, enforce that the dot between the viewpoint direction vector (possibly disregarding the Y coordinate) and the viewpoint-to-spawnpoint vector is within a certain range, ensuring that the camera will always be visible.",
      "viewerReactions": null
    }
