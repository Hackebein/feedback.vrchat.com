      "spam": false,
      "statusChangeID": null,
      "value": "This happened to me and a group of friends last night, it persisted through world changes. Restarting the client temporarily resolved the issue, but after half an hour it would come back to some players, but not everyone.",
      "viewerReactions": null,
      "voteID": null
