      "pinned": false,
      "postDeleted": false,
      "postID": "631a4ce19b6ea744a6e76f83",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "My current workaround\n\n1. Locate %appdata%/../LocalLow/VRChat/VRChat/Avatars\n\n2. Upload test avatar avi1, duplicate it and rename the copy to avi2\n\n3. Edit avi1 and test upload\n\n4. Rename avi1 to avi2\n\n5. In game switch to an other avatar than avi2 and then back to it\n\nRepeat 3-5 whenever you upload the test avatar\n\nThis is a bit tedious workaround but better than restarting the game for every upload.",
      "viewerReactions": null,
      "voteID": null
    }
