        "alias": "Complex Halibut",
        "aliasID": "65c2c0eaed6eefce4c7a7ef7",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/c0b6c1520ecef2e3ca753e21c9c7d064.png",
        "created": "2020-08-08T01:50:58.459Z",
        "name": "speedbuiz",
