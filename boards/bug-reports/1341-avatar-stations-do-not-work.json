      "parentID": "653111da6882fc26c0c461fa",
      "pinned": false,
      "postDeleted": false,
      "postID": "64ebd6d8d1b9dd09809a3ae9",
      "private": false,
      "reactions": {
        "like": 1
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Apparently if a collider component is on the vrcstation gameobject, it will not re-activate that collider component when re-enabling.  \n\nThe solution appears to be to remove the collider component completely and rely on the vrcstation component to generate one itself (Scaling the gameobject with the component controls the scale of the box collider generated).\n\nDoing this restored functionality to allow toggling on and off.",
      "viewerReactions": null,
      "voteID": null
    },
