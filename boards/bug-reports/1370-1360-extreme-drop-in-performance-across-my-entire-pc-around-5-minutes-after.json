      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "65380a977185b37795cf6e6f",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This issue appears to be related to certain Thunderbolt/USB4 controller drivers, often present on AMD x670e motherboards - processes (like Anticheats and hardware diagnostic software) interacting with those drivers seem to trigger Windows Power Management, which leads to this issue. Users elsewhere have reported that other software that interacts with these drivers (such as HWInfo64 and CPU-Z) can also trigger this system-level slowdown, as well as other applications that utilize EAC.\n\nBecause this seems to be a driver-level or OS-level issue, and not unique to VRChat, we'll be closing this. We recommend following the steps in the pinned comment if you're experiencing this on your system, as we've confirmed with multiple users that this seems to solve the issue on their systems.\n\nAdditional workaround:\n\nRight click Start Menu => Device Manager => System Devices => Thunderbolt(TM) Controller - 1137 => Properties => Power Management => Uncheck \"Allow the computer to turn off this device to save power\" => OK",
      "viewerReactions": null,
      "voteID": null
    },
