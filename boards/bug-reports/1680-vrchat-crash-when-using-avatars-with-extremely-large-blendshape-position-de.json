      "spam": false,
      "statusChangeID": null,
      "value": "Fixed in 6000.5.0a5...\n\nhttps://issuetracker.unity3d.com/issues/silent-crash-when-using-a-blend-shape-in-a-skinned-mesh-renderer-to-move-vertices-to-vector3-dot-positiveinfinity-and-occlusion-culling-is-baked",
      "viewerReactions": null,
