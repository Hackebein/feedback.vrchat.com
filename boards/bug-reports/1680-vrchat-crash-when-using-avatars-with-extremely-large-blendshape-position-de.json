      "statusChangeID": null,
      "value": "Most game engines really don't like dealing with infinity sizes. Maybe you should shrink the elements down inside the avatar? That's what most people do with elements of an avatar they need to hide.",
      "viewerReactions": null,
      "voteID": null
    },
