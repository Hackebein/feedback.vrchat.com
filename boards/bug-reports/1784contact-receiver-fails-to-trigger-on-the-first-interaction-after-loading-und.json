      "spam": false,
      "statusChangeID": null,
      "value": "More precisely, this bug appears to behave as follows:\n\nIf there is an active Contact Sender within a Contact Receiver's range immediately after the avatar is loaded or scaled, the Receiver will stop responding until the Sender leaves the Receiver's range at least once.",
      "viewerReactions": null,
      "voteID": null
    }
