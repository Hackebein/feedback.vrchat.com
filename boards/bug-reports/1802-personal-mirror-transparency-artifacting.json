      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "For any internet traveler coming here in the future, you can fix this on your shaders/materials (with poiyoimi) by correcting these values under Blending:\n\nAlpha Destination Blend - OneMinusSrcAlpha \n\nAlpha Blend Op - Max \n\nThey were set to something else because your material had a different rendering mode before you switched to opaque.",
      "viewerReactions": null,
      "voteID": null
    }
