      "statusChangeID": null,
      "value": "@{5b64131d7f033f28768aaa73|full_name}: I have no issue with using 1024, as long as you write GiB instead of GB. Using 1024 while writing GB is just incorrect and ambiguous.",
      "viewerReactions": null
    },
