      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I agree that it shouldnt be blindly nuked: if all people orange - no show, but if one of multiple is green - show.\nAlso should be kept visible if its own instance - so one can rejoin after crash/headset restart",
      "viewerReactions": null,
      "voteID": null
    },
