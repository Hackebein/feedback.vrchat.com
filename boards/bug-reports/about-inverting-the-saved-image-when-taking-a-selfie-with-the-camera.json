      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "FYI. The identical issue: https://feedback.vrchat.com/bug-reports/p/about-inverting-the-saved-image-when-taking-a-selfie-with-the-camera",
      "viewerReactions": null,
      "voteID": null
    },
