      "statusChangeID": null,
      "value": "This would be the fix for VCC that VRChat has to do:\n\nOpen file \"VRChatCreatorCompanion\\VRCTemplates\\Avatar\\Packages\\manifest.json\" and change some lines to match Unity 2022.3 start project. Line 8 is the important one causing the problems described above.\n\n- Line 6 from \"\"com.unity.test-framework\": \"1.1.29\",\" to \"\"com.unity.test-framework\": \"1.1.33\",\"\n\n- Line 7 from \"\"com.unity.textmeshpro\": \"2.1.6\",\" to \"\"com.unity.textmeshpro\": \"3.0.6\",\"\n\n- Line 8 from \"\"com.unity.timeline\": \"1.2.18\",\" to \"\"com.unity.timeline\": \"1.7.5\",\" or 1.7.6 which is the latest version at the time of writing",
      "viewerReactions": null,
      "voteID": null
    },
