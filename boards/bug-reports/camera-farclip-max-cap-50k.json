      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This change has broken MANY of my existing worlds that I no longer have the files for. Even if it simulates a crash, worlds have functioned fine for years with high clipping planes, up until now. \n\nPlease fix this stupid fucking issue.",
      "viewerReactions": null,
