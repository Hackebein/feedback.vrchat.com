      "companyID": "58c62e995865713647a7115d",
      "created": "2024-04-05T22:04:31.674Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
