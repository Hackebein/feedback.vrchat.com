      "statusChangeID": "640f6f6fdc1202452d3c0a59",
      "statusChangeNewStatus": "closed",
      "value": "This issue will not be directly fixed any time soon, instead it has been fixed by exposing TrackingData.Origin and the use of TeleportTo with SpawnOrientation.AlignRoomWithSpawnPoint. This does a much more stable teleport that does not depend on the rotation of the player's head.\n\nAdditionally, make sure that you are using LerpOnRemote:true so that other players see smooth movement.",
      "viewerReactions": null,
      "voteID": null
    }
