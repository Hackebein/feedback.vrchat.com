        "https://canny.io/images/06a3cbd989f4260812f6cbfaf11da7dd.png",
        "https://canny.io/images/8cba9bdeebb80008f20abf7d127bbe05.png",
        "https://canny.io/images/0799e2e12ee91872e0d9a4bf9557f71f.png"
      ],
      "integrationSourceType": null,
