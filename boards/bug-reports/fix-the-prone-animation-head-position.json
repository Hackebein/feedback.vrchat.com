        "anonymized": false,
        "avatarURL": "https://canny.io/images/65372a3ccd71bbcae86689c5a73ee043.png",
        "created": "2018-08-22T20:04:43.909Z",
        "name": "Himeki",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62f2b3cf8f8367753b2f0",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-09-09T17:45:48.866Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 1,
