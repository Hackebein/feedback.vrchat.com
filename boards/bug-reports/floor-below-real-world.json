      "companyID": "58c62e995865713647a7115d",
      "created": "2022-05-26T23:18:50.984Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [
        "https://canny.io/images/0f8810915bd090cf7f9552cf55429423.png"
      ],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "5a8502bb47e5aa52ee6e9f22",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This problem can now be resolved in VRChat 2022.2.1 by changing the settings.\nhttps://docs.vrchat.com/docs/vrchat-202221\nQuick Menu → Settings → Tracking and IK → Avatar Measurement and set it to eye height reference (left) to resolve this.",
      "viewerReactions": null,
      "voteID": null
    },
