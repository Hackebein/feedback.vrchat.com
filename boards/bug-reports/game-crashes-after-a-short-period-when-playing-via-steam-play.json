      "pinned": false,
      "postDeleted": false,
      "postID": "615a925cba9a4d3cd9baf56f",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This behavior is still present on the Open Beta branch (Oct 8 2021)\nIt seems that, for some reason, removing the OVRLipSync DLL will correct this issue. It does break lip-sync, however the game stops leaking VRAM. Using an older version of Proton (such as 5.13) where the OVRLipSync DLL fails to load properly will also cause the game to run properly (minus lip-sync).",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "616b71a99408073e8146a3c3",
      "author": {
        "_id": "5fb62533a46ced5cad82b2de",
        "alias": "Waterspout Trout",
        "aliasID": "65ed3278a6e3ea79dde7af2f",
