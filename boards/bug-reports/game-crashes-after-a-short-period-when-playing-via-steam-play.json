      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "615a925cba9a4d3cd9baf56f",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "An additional workaround, in place of removing the OVRLipSync DLL also appears to be using the AMDVLK Vulkan driver, instead of RADV. Launch Steam ensuring the AMD Switchable Graphics layer is set to AMDVLK, and then SteamVR and VRChat. It does cause some performance issues and stuttering, but these seem to be related to SteamVR and AMDVLK not playing nice together, however the game does stop leaking memory.",
      "viewerReactions": null
    },
