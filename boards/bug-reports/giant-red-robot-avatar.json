      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Workaround until this is fixed:\n- Exit VRChat\n- Log in to https://vrchat.com/home/\n- Open the developer console (press Ctrl+Shift+i)\n- Paste this into the developer console:\n$.ajax({url:'/api/1/avatars/avtr_e88aa833-7856-4b42-bddf-dc568651a332/select',type:'PUT',success:console.log});\n- Reopen VRChat. You should now have the \"VRChat Default Bot\" avatar.",
      "viewerReactions": null
