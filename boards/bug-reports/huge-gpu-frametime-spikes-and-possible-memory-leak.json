      "statusChangeID": null,
      "value": "After the latest update my 3080TI has been pegged at like 90%+, developed coil whine and is less performant. I've turned down loads of settings and my VR Resolution and still no improvement.",
      "viewerReactions": null,
      "voteID": null
    }
