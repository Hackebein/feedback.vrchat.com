      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It is not practical to keep approximately 10 GB of cache in memory while remaining stationary in a specific, small-scale world—especially when running on a system equipped with an SSD.",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "_id": "6a8edbad0e8c4c8b0c268c5f",
      "aiGenerated": false,
      "author": {
        "_id": "5cb6a908df8d8e58c38318a3",
