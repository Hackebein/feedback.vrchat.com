      "statusChangeID": null,
      "value": "Thank you for finally addressing this! I've confirmed that my group members now get an error if the members-only instance permission is enabled, but they are attempting to invite themselves to a new group public instance via the browser.",
      "viewerReactions": null,
      "voteID": null
