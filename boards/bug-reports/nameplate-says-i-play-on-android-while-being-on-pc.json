      "created": "2024-01-07T11:26:32.520Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [
        "https://canny.io/images/286b7e555e7451d0c53369364534ab9a.png"
      ],
      "integrationSourceType": null,
      "internal": false,
