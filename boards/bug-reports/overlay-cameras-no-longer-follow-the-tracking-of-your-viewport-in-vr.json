          "avatarURL": "https://canny-assets.io/images/6c978cb431d0981c14cc1eb5202f0d8a.png",
          "created": "2020-04-05T12:35:14.620Z",
          "name": "Whaddageek",
          "serviceAccount": false,
          "urlName": null
        }
      ],
      "mergeID": null,
      "parentID": "65a65cbce7c8a1f9d129e103",
      "pinned": false,
      "postDeleted": false,
      "postID": "659afb2961185b1d2352ca8a",
      "private": false,
