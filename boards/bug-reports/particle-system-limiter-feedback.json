      },
      "authorID": null,
      "boardID": "58c62f2b3cf8f8367753b2f0",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-04-25T18:23:42.086Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
