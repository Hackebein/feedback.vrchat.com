      "created": "2020-04-28T01:10:48.008Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
