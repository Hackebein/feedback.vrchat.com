      "boardID": "58c62f2b3cf8f8367753b2f0",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-11-17T10:06:06.105Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
