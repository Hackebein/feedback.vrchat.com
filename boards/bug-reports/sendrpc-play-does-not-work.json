    {
      "_id": "5e8cf63151b2c33b3fae7812",
      "author": {
        "_id": "5a3ad8ac4a8da67427803715",
        "alias": "Proposed Gibbon",
        "aliasID": "65c27aa0ed6eefce4c6c34a0",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/a780d77c380ab00ed8e4b7e97e271fad.png",
        "created": "2017-12-20T21:39:56.045Z",
        "name": "Ruuubick - Designer",
        "serviceAccount": false,
        "urlName": null
      },
      "boardID": "58c62f2b3cf8f8367753b2f0",
      "companyID": "58c62e995865713647a7115d",
      "created": "2020-04-07T21:52:49.147Z",
      "deleted": false,
      "fileURLs": [],
