      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{5ae14b192f26cf1a6d66ba79|full_name}: Make sure you select \"Bake and Discard\" when using Substance materials. The procedural generation can take a long time and may cause loading to time-out.",
      "viewerReactions": null
    },
