      "postID": "5c9862158c3b804575a9d222",
      "private": false,
      "reactions": {
        "like": 2
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I encountered the same issue a while back, but figured out a solution:\n\n-Select your Substance Material in Unity\n-In the inspector, scroll all the way down and expand \"Generated Textures\"\n-For \"Load Behavior\" choose \"Bake and discard Substance\" from the drop-down menu\n-Press Apply\n\nReupload your world/avatar and hopefully that should do it.",
      "viewerReactions": null
    },
