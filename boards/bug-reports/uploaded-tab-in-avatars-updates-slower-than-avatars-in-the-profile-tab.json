      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": "636a9ea0aa488a3734817b5f",
      "mergedPostDetails": "Since this latest update I and almost all of the friends I have asked have noticed that uploading now takes waaaaay longer then it used to, where it used to take a few seconds to maybe a minute top to update an already uploaded avatar it now takes sometime upwards of 5-10 mins which is becoming quite frustrating if I am being completely honest and that's just for updating an existing avatar, if you want to upload an avatar fresh it can take almost 20-30 minutes sometimes depending on how much is on the avatar, which even on the most unoptimised of avatars never used to be the case, all my projects are on an M.2 SSD and nothing has changed in my computer spec wise recently.",
      "mergedPostTitle": "Uploading Avatars is taking alot longer then it used to",
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "6348447c84512517e7999c4e",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "What exactly do you mean with Uploading? The time it takes for Unity to show that it finished uploading or the time it takes for it to show up ingame in your Menu?",
      "viewerReactions": null,
      "voteID": null
    },
