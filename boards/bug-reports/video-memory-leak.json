        "_id": "59b1485b4493c77bec9117bd",
        "alias": "Public Barnacle",
        "aliasID": "65ba016fed6eefce4cf17e39",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/1ccecf4622c2f822f9ce347a6cc791d7.png",
        "created": "2017-09-07T13:23:39.163Z",
        "name": "euan",
