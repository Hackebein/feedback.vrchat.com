      "private": false,
      "reactions": {
        "like": 4
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I'd tried everything, and nearly given up on being able to play this game again. \nI just now tried uninstalling AND deleting  \\Steam\\steamapps\\common\\VRChat (which is an additional step above and beyond the other one that includes purging temp files and registry). \nTHAT WORKED.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5ecaec58c1a2da1be8d98f96",
      "author": {
        "_id": "5ec234d7f9a0ef61a5317947",
        "alias": "Clever Crab",
        "aliasID": "65c71ff4ed6eefce4c37f37a",
        "anonymized": false,
        "avatarURL": null,
