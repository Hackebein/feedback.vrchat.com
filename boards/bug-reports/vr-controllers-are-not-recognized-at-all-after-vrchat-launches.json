      "companyID": "58c62e995865713647a7115d",
      "created": "2020-05-24T21:51:20.425Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 1,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": "5e85256f1b795372945fada1",
      "pinned": false,
      "postDeleted": false,
      "postID": "5e850e0a3aedaf72bf1c66c3",
      "private": false,
      "reactions": {
        "like": 4
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "And then it came back. But I figured it OUT!\nLiv is creating a file called externalcamera.cfg in steamapps\\comon\\VRChat. ***This is not removed on uninstall, and is the culprit. When VRChat sees this file, for some reason it disables the controller inputs!",
      "viewerReactions": null
    },
    {
