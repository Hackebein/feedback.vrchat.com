      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "By default, Steam rates an account as \"Active\".\nTo gain the \"Trusted\" status on the Steam platform, the following has to have happened:\nAn transaction made directly on Steam, that happened over 90 days ago, and not had a chargeback.\nAs soon as that is the case, Steam will switch over the account to the \"Trusted\" status and you shouldn't see this message appear again.\nTho, as Tupper said, the VRChat support might be able to help you out.",
      "viewerReactions": null
    }
