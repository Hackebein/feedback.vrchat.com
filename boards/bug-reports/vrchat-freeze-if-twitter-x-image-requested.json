      "statusChangeID": null,
      "value": "Additional info:\n\nLoading any YouTube URL 3 times from String/Image loader will cause 50% of VRChat installs to crash (not beta/stable related, tested on 10 different computers).\n\nIt can be done from any mixture or the same YouTube URLs and even split across multiple instances.\n\nExample URLs:\n\nhttps://www.youtube.com\n\nhttps://www.youtube.com/watch?v=_wkjtCuOuzE",
      "viewerReactions": null,
      "voteID": null
    }
