      "sourceLink": null,
      "spam": false,
      "statusChangeID": "6243811c5366b9527a80c45d",
      "statusChangeNewStatus": "complete",
      "value": "VRChat 2022.1.1p4, build 1173 has updated to the latest version of OVRPlugin. According to oculus, it fixes the following issue:\n\"OVRPlugin can't be loaded on certain CPUs that do not support AVX2 instructions\"\nIt appears that this caused the issue being described in this post. If you have been affected, please try updating. Post here again if the issue persists.",
      "viewerReactions": null,
      "voteID": null
    }
