      "authorID": null,
      "boardID": "58c62f2b3cf8f8367753b2f0",
      "companyID": "58c62e995865713647a7115d",
      "created": "2022-03-15T12:06:53.288Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
