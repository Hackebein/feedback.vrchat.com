      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "5a99af19662dbc14d5d77fc2",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "value": "The current video player is Unity's so this applies:\nhttps://docs.unity3d.com/ScriptReference/Video.VideoPlayer.html\n\nNot all YouTube videos provide the correct combinations of audio/video in the right container. So if you are using YouTube links sometimes YouTubeDL will give you the best it can for that video and it won't be compatible with Unity's built-in video playback.",
      "viewerReactions": null
    },
