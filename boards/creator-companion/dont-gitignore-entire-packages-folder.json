        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "617b2e52d78bc972ff325a03",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-10-10T09:41:11.426Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
