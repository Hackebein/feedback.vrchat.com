      "statusChangeID": null,
      "value": "@{5de9405aea7cc52772fcc359|full_name}:\nThis .gitignore, which has changed since the VPM release version, also excludes com.vrchat.core.*.\n```\n/*/\n!com.vrchat.core.*/\ncom.vrchat.*/\n```\nThe order should be rearranged as follows.\n```\n/*/\ncom.vrchat.*/\n!com.vrchat.core.*/\n```",
      "viewerReactions": null,
      "voteID": null
    }
