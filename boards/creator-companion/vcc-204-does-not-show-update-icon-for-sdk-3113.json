      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Found out the issue, its how the versions are listed inside of vrc-curated.json and vrc-official.json, the order is flipped inside of the VCC than what is inside of the json files, by moving 3.1.13 to the bottom in VRCSDK - Avatars for example, it would show at the top of the dropdown, however, the VCC automatically updates the .json every time you hit manage project after first open it, making it where you cant personally edit the json to fix it",
      "viewerReactions": null,
      "voteID": null
    },
