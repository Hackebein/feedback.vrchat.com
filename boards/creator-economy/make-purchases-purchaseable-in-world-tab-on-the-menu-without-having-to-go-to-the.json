      "statusChangeID": "67374effafd2fd53a2f059c1",
      "statusChangeNewStatus": "tracked",
      "value": "We're working on a new feature called \"World stores\"! This is a new, separate system from group stores and subscriptions.\n\nCreators who participate in the Creator Economy can use it to sell one-time purchases for their world(s). This makes it easier to discover store items!\n\nThe feature is releasing soon - but creators need time to implement it, so we hope you look forward to seeing what creators come up with!",
      "viewerReactions": null,
      "voteID": null
    },
