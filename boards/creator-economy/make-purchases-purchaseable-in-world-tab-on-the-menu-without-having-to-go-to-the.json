      "statusChangeID": "6960ff9466c756c5d9ee2f04",
      "statusChangeNewStatus": "complete",
      "value": "Thank you for the suggestion! We implemented world stores in March 2025. This allows you to buy listings directly from the world details page.\n\nWorld creators choose which listings appear here, so you might still need to join the world to see everything they have to offer!",
      "viewerReactions": null,
      "voteID": null
