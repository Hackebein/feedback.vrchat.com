{"error": null, "lastUpdated": 1778729370487, "loading": false, "notFound": false, "_id": "680ffb332507f51ccb6427cb", "authorID": "60ee9e81572cc51ad4e847e6", "boardID": "66ede8e631e33a29e8669bfa", "byID": null, "categoryID": null, "commentCount": 0, "companyID": "58c62e995865713647a7115d", "deletedAt": null, "deletedBy": null, "details": "Adding categories to the Example Central UI would help World Creators find specific examples from a topic like Persistence and Creator Economy rather than the current big list of just names.\n\nThis would also make it noticeable to the user when Creator Economy examples are disabled since the user would notice the missing Creator Economy category.\n\nMaking these categories collapsible would help when more example/features are added like the new VRC+ Drone.", "eta": null, "etaPublic": true, "fileURLs": [], "imageURLs": [], "maxScore": 4, "ogImageURL": "https://canny-assets.io/images/og/58c62e995865713647a7115d/posts/680ffb332507f51ccb6427cb/1129001958.jpeg", "score": 4, "status": "open", "subCategoryID": null, "title": "Add Categories to Sort Examples With", "trendingScore": 2899.863096873574, "updatedAt": "2026-05-14T03:31:44.837506Z", "updatedBy": null, "urlName": "add-categories-to-sort-examples-with", "created": "2025-04-28T22:03:31.530Z", "statusChanged": "2025-04-28T22:03:31.530Z", "__v": 0, "ideaID": "680ffb332507f51ccb642839", "viewerVote": 0, "linkedEntry": null, "board": {"_id": "66ede8e631e33a29e8669bfa", "name": "Example Central", "urlName": "example-central"}, "category": null, "voters": [{"_id": "5f25e05544df0a7147c57b5f", "alias": "Dahlia Wildfowl", "aliasID": "65c270b7ed6eefce4cd260b9", "anonymized": false, "avatarURL": "https://canny-assets.io/images/8b3a24a85939bb09d575509cb8ff041d.png", "name": "Nullmatic", "urlName": "<redacted>", "voteID": "68896e8a076be5baa6ac1cd0", "companies": []}, {"_id": "62e1a77f910ca544ac004db9", "alias": "Neon carrot Chickadee", "aliasID": "6614e6dae5d26962aa7b899f", "anonymized": false