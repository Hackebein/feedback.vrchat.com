      "spam": false,
      "statusChangeID": null,
      "value": "To increase compatibility, maybe have an option in the SDK to toggle 1-frame visemes, so it doesn't break the pre-existing 3D visemes/models.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5bea0f3dfd98475fa31c69ee",
      "author": {
        "_id": "5b0b06e952d6c72deb336627",
        "alias": "Net Kite",
        "aliasID": "65d0d32c0129d7ae44a01c13",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/1f98d3e62b8f981e992211db67e7185c.jpg",
        "created": "2018-05-27T19:28:41.841Z",
        "name": "Nifty255",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-11-12T23:39:41.747Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
