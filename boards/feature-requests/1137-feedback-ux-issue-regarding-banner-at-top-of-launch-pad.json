      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "That banner is such an eye sore and take up valuable space not to mention the extra steps now to access settings which should be on the QM as that is more important to access instead of emoji which can be easily accessed through the action menu.\nas the OP stated it would be nice if the banner would dissappear after seeing it once or just have a tab for news instead of a banner that takes up half the QM.\nplus seeing that ugly banner there is making me paranoid that you guys are going to eventually add ads into the game even if the devs said they wouldn't i wouldn't put it past them as game devs have gone back on their word before.",
      "viewerReactions": null
    }
