      "reactions": {
        "like": 4
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Assuming both parties (Mirror user and remote user) to be able to opt out of this indicator, it'd be great. \nMy contribution: I think it would be cool if you'd be able to snap your mirror to the indicator, allowing multiple player's mirrors to act in sync.",
      "viewerReactions": null,
      "voteID": null
    },
