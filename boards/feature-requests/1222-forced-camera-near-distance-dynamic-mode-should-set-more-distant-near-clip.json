      "spam": false,
      "statusChangeID": null,
      "value": "This is because the GPU in the Quest uses fewer bits for depth (“Half Float” instead of Single Float), which reduces the precision of geometry that is in front of the player. Clip distance adjustment cannot overcome this issue in many cases (objects more than 5 meters away) because there is so little precision available to begin with.",
      "viewerReactions": null,
      "voteID": null
    }
