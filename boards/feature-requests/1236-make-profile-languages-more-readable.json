      "statusChangeID": null,
      "value": "The flag idea is problematic because languages don't necessarily have a one-to-one relationship with countries. VRCX, for example, uses flags to represent languages and hilariously uses the American flag to represent English, which is most offensive to my sensibilities as I sip my tea.",
      "viewerReactions": null,
      "voteID": null
    }
