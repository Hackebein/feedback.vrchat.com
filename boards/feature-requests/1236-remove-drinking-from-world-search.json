      "_id": "631ca22c25cedc44cff0c213",
      "author": {
        "_id": "629ad571a782f30b69d2521f",
        "alias": "Content Antlion",
        "aliasID": "65c2c0e3ed6eefce4c799d71",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/39408d7c66a2dcceb4efe658ff145691.png",
        "created": "2022-06-04T03:45:53.019Z",
        "name": "AgenderWitchery",
        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2022-09-10T14:41:48.380Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
