      "mergeID": "66399702d502b81fb28ce622",
      "mergedPostDetails": "For those who join Group Public, or Group+ instances, non-members who join the instance should be shown the list of group rules before proceeding to explore that instance.",
      "mergedPostTitle": "Non-members should receive a list of Group rules when joining a Group instance",
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "6476ac2be4f7c649260735a0",
      "private": false,
      "reactions": {
        "like": 2
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Yeah this seems great, a pop up box like the you have been kicked box which shows the rules and doesn’t allow you to continue for like 10 seconds! Makes it simple for newbies to understand the rules!",
      "viewerReactions": null,
      "voteID": null
    },
