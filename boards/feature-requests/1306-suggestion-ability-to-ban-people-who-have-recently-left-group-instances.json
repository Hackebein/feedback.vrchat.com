      "spam": false,
      "statusChangeID": null,
      "value": "I like this idea, sometimes you wanna block someone so you don't ever meet them again but if they leave or are kicked before you have a chance to do it, you may have to bump into them again.",
      "viewerReactions": null,
      "voteID": null
    }
