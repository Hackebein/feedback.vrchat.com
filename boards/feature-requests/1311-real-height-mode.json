      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "A lot of people set their avatar height as their real height. This is incorrect: Avatar height is actually the height of the viewpoint, not the height of the top of the head (it should be renamed to eye height or viewpoint height).\n\nReal Height Mode would remove this uncertainty and just scale everyone appropriately to their actual heights.",
      "viewerReactions": null,
      "voteID": null
    },
