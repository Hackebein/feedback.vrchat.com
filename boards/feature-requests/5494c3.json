      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": "6acca56a70875364d4e5795c",
      "pinned": false,
      "postDeleted": false,
      "postID": "6acc404f70875364d4d74fb1",
      "private": false,
      "reactions": {
