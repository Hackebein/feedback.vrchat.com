      "statusChangeID": null,
      "value": "This is not a supported method of disabling full-body.\n\nAs it currently stands, the only \"officially supported\" method of swapping between 3PT, 4PT, and 6PT tracking is restarting VRChat.",
      "viewerReactions": null
    },
