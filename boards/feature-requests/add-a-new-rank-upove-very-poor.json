    {
      "__v": 0,
      "_id": "5ecc0d21beaaae7f66753369",
      "author": {
        "_id": "5ebf0260515da519840fc3da",
        "alias": "Varied Sturgeon",
        "aliasID": "65d248ae0129d7ae44234266",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/fcf2759b64f51d1710b347da41084905.png",
        "created": "2020-05-15T20:58:08.923Z",
