      "spam": false,
      "statusChangeID": null,
      "value": "I'm digging into the users' reactions to the Japanese localization.\n\nThere have been some comments about the position of line breaks, but without this requested feature, we are unable to fix the problem.",
      "viewerReactions": null,
      "voteID": null
    }
