      "statusChangeID": null,
      "value": "Note that this trigger probably shouldn't be triggered by AV3 parameter drivers running on the local client, as this might trigger infinite loops; if this behavior is desired the parameter driver can just be configured to fire off the trigger directly.",
      "viewerReactions": null,
      "voteID": null
