      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It's important that the term \"User-Generated,\" which VRChat is built on, isn't poisoned with content that is not generated by users. If it is allowed it needs to be in a separate category like how many other art sites do it.",
      "viewerReactions": null,
      "voteID": null
    }
