        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-03-13T14:29:21.998Z",
      "deleted": false,
      "deletedAt": null,
      "fileURLs": [],
      "files": [],
