      "author": {
        "_id": "5baf8f37b35bcd344d15d0bf",
        "alias": "Fiscal Sparrow",
        "aliasID": "65c430bbed6eefce4c74e2b6",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/a7ab8f9e011cc290604f3f10c9146e7d.png",
        "created": "2018-09-29T14:41:59.231Z",
        "name": "DONAMO-163",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-07-15T11:02:53.663Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
