      "spam": false,
      "statusChangeID": null,
      "value": "I feel you answered your own question, If you feel the need to sleep in vrchat, put yourself on \"Do not disturb\" and people wont join off of you.\n\nAs for wanting people to join, is there a point since your already sleeping?",
      "viewerReactions": null
    }
