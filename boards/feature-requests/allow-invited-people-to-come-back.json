      "pinned": false,
      "postDeleted": false,
      "postID": "5c41be5dcc5f0a18d187b973",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "If this were added, then someone in the world should be able to remove them from the \"invited\" list, or it should be possible to turn off. Maybe the vibe has changed, or maybe the people left in the world don't really know that person, but whatever the reason, having someone who was at some point invited (or joined someone on blue) join what is supposed to be a \"private\" world unannounced would... not necessarily be welcome.",
      "viewerReactions": null,
      "voteID": null
    }
  ],
