      "spam": false,
      "statusChangeID": null,
      "value": "@{68098a4626271974ef4d2775|full_name} Thank you for checking with screenshots! You're right — I posted this based on a secondhand report and couldn't verify it myself. I've edited the post to be a feature request instead: since Request Invite was never available for joinable instances, I'd like it to be added. Hopefully moderators can\n\nmove this to the Feature Requests board.",
      "viewerReactions": null,
      "voteID": null
