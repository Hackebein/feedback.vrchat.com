      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Went to make a post about this and discovered this post was already made!! Please allow us to lower our cache size. I understand a value too low would cause issues, but 20gb is quite large for a minimum number.",
      "viewerReactions": null,
      "voteID": null
