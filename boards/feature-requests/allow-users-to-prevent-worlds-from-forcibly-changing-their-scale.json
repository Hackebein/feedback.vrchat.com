        "aliasID": "65c289dced6eefce4cc219ab",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/aa7cb5b4077fd4358edf6fe393c6691e.png",
        "created": "2020-08-11T11:54:45.784Z",
        "name": "Reimajo",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-07-15T08:44:56.750Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
