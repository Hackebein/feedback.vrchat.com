      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "For context, I spend a lot of time in crowds at events at crotch-level of tall avatars of inconsiderate people. That's inappropriate for the experience I came to share with other people. My experience matters and venue operators are the best people to have the tools to protect that.",
      "viewerReactions": null,
      "voteID": null
    },
