      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "You only need one listening port, multiple programs can send messages to VRChat at the same time, but having a comma-delimited list of sending ports would solve the problem of only one program being able to bind a port and listen to VRChat.\n\nThis basic feature that can be added by making the osc parameter accept an optional comma-delimited list of sending ports would eliminate the need for a whole new program (OSCQuery)",
      "viewerReactions": null,
      "voteID": null
    }
