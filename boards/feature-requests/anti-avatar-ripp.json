      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "64de66862106a7665543e749",
      "private": false,
      "reactions": {
        "like": 10
