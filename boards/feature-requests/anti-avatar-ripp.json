    {
      "__v": 0,
      "_id": "64ded5ebc756c4092e398762",
      "author": {
        "_id": "627289d1f270d413d04be59f",
        "alias": "Double Possum",
        "aliasID": "65c290c9ed6eefce4cd400b3",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/a98afd5ad34a0bc1ee4511612d7666dc.png",
