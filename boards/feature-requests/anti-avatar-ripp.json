      "statusChangeID": null,
      "value": "@{64e6f064fe9e90bf40bb1506|full_name}: Well, we don't want the SDK to do the signing, because then the rippers will just decompile the SDK and find out how the signature is generated, and then update their process to rip it out.\n\nThis has to be done on the server end, after the assets have been transmitted to VRChat.  This way, the rippers have to try and figure out how the signature is inserted and recognized so they can find it without costly manual intervention for each upload.",
      "viewerReactions": null,
      "voteID": null
    }
