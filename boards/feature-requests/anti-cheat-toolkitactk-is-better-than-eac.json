      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2022-08-09T02:38:37.316Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": "62f0db946996cf44ab3a8658",
      "pinned": false,
      "postDeleted": false,
      "postID": "62ece5009b3a74449ec80eb4",
      "private": false,
      "reactions": {
        "like": 2
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Whether it is EAC or ACTk, malicious users with certain technical skills will always find a way to bypass it\nThis is evident from the fact that even Fortnite, which is developed and operated by Epic, the provider of EAC, has cheats\nThe key question is how long it will take for the EAC to respond once the cheat tools start showing up, and whether they will respond in the first place.\nAlso, there are parts of VRChat Team that cannot be controlled, and that is that it runs at the kernel level.\nthe source code of ACTk is open to user, the VRChat Team can control all the behavior of the system.\nIt is also possible to take immediate action against cheat tools that emerge.\nOf course, this is not the best solution, but it is better than the current situation where third-party code is running at the kernel level, which is highly privileged and whose details cannot be verified by the management.",
      "viewerReactions": null,
      "voteID": null
    },
