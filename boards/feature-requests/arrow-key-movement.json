      "statusChangeID": null,
      "value": "You are right. I use another combination for moving (not WASD) and reconfiguration using SHIFT+START in STEAM has no affect. So I use third party software for keyboard remapping: “AutoHotkey”.",
      "viewerReactions": null
    }
