      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "5c3cba9d458a806c4177f293",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "The performance rating system is still very new, and some aspects on avatars make it impossible to gauge how much of an effect on performance it actually has (for example, material count with multi-pass shaders). It isn't really in a state where it can be used as a de-facto last word on how optimized an avatar is, so I feel like it'd be a bad decision to automate anything based on it. This is just my personal opinion, and I also feel like this kind of thing could be a great addition in the future.",
      "viewerReactions": null
    },
