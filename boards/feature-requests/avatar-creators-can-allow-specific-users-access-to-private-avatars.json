      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "this is a feature i've wanted for so long, especially for things like commissions\n\nit would also prevent commissioned avatars uploaded to my account from cloning being left on by accident\n\nin response to the unity files guy, if avatar creators choose to do something like that, it's kinda their choice, this would be extremely helpful to a lot of avatar creators and VRChat isn't really able to manage people gatekeeping unity files, so abandoning this idea just because of that would be kinda stupid.",
      "viewerReactions": null,
      "voteID": null
