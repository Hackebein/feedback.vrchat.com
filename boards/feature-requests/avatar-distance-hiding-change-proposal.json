      "statusChangeID": null,
      "value": "This makes sense to me! But I think the best approach will be found out through experimentation. Hiding X avatars sounds very consistent, but I hope it's not too confusing in a crowded room.",
      "viewerReactions": null,
      "voteID": null
    }
