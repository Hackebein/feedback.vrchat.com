      "spam": false,
      "statusChangeID": null,
      "value": "This is something similar to I requested a few months ago and I agree that there should be something that could help with that. https://feedback.vrchat.com/avatar-30/p/components-that-take-transform-values-and-output-them-to-custom-shader-propertie\n\nIdeally this system would be closer to this unity asset https://assetstore.unity.com/packages/3d/animations/blendshape-driver-176301",
      "viewerReactions": null,
      "voteID": null
    }
