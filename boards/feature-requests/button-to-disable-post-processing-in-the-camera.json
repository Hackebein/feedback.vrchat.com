      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I'd like if we just had this option in general for regular use. I've been to a ton of maps that are really nice only to be let down by some awful color grading changes the author made, over exposing and blackening darks, really bums me out lol",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "643c7f8c9b364a09084eb87b",
      "author": {
        "_id": "5fe0a7b0149d3c2965c6f43f",
        "alias": "Known Wildcat",
        "aliasID": "65c2ae1fed6eefce4c0b9919",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/b50ce3cfe2202b5a237be19e456bc6df.png",
        "created": "2020-12-21T13:48:32.140Z",
        "name": "tw1l1ght75",
        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-04-16T23:06:52.222Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
