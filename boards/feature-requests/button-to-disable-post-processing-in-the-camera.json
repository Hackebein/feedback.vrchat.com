      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "i understand the need for post processing in worlds where everything is too bright when PP is off, so there should at least one option to toggle PP off and another exposure control in camera. Screen brightness in the game menu doesn't change the camera exposure.",
      "viewerReactions": null,
      "voteID": null
    },
