      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I have a permanent and painful medic condition that prevents me from playing vrchat standing up or even sitting most of the time, so I prefer to play laying down. The ability to access the menu while laying down is REQUIRED to play this game. The ability to ACCESS THE MENU shouldn’t be a constant reminder of how my body is broken.",
      "viewerReactions": null,
      "voteID": null
    },
