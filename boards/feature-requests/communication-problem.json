      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "There are people among my friends at VRChat who have not logged into the game for more than one year. If I could send them a message in VRChat and they receive a notification about it on their e-mail, then perhaps they would return to the game. Is this a powerful argument for you, dear developers?",
      "viewerReactions": null
    }
