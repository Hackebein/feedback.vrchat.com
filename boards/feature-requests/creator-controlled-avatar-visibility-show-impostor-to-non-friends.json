      "spam": false,
      "statusChangeID": null,
      "value": "One issue I've noticed about this is that trolls could take advantage of this to use inappropriate avatars in more public instances.\n\nInstance mods would need to be able to see the full avatar of the user regardless if they're friends or not in order to determine if the avatar is appropriate.",
      "viewerReactions": null,
      "voteID": null
    }
