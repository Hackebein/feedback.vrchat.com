      "spam": false,
      "statusChangeID": null,
      "value": "4 years later and this still isn't a thing.  Why is that?  It's an easy option to add.  We shouldn't be limited to opening a public instance in a PC only world.",
      "viewerReactions": null,
      "voteID": null
    }
