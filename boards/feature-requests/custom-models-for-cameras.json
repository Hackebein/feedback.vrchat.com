      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Currently, the use of a custom camera requires the use of the custom camera functionality from the previous camera system, which is a specialized avatar camera system that is overloaded and occupies avatar parameters.\nIf the default camera could be changed to any camera 3D model without using such a function, it would save parameters.",
      "viewerReactions": null,
      "voteID": null
    }
