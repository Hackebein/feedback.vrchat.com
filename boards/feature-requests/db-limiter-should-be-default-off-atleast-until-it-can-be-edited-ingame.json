      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It's pretty lousy there isn't an ingame option for this. You can view https://docs.vrchat.com/docs/avatar-dynamic-bone-limits then create a config file (read the page) and set your own limit.",
      "viewerReactions": null
