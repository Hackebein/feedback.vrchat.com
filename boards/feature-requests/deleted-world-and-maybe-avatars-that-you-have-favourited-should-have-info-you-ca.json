      "spam": false,
      "statusChangeID": null,
      "value": "I've seen avatars become unable to switch to, they're greyed out, but you can still see the preview and the name. I believe they should just be removed from the favorites list if it's been removed from the game. Like it doesn't exist so why does it leave behind a ghost of itself, it would be easier to cope with if it just vanished entirely instead of leaving me with anxiety of \"WHAT WAS IT?!\"",
      "viewerReactions": null,
      "voteID": null
    }
