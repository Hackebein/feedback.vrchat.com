      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Would be great to have a \"proportional movement speed\" toggle on the expressions menu now that we have avatar scaling built in to the game, where if you shrink below default you can optionally move slower. Perhaps there can be a cap to the maximum speed if there's a concern that going faster than default would cause issues with cheating in a game world, or the max and min speeds could be defined by world authors.",
      "viewerReactions": null,
      "voteID": null
    }
