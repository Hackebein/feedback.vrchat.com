          "alias": "Rival Dragon",
          "aliasID": "65c291aeed6eefce4cf54507",
          "anonymized": false,
          "avatarURL": "https://canny-assets.io/images/e48330a3f693888383233238a4ebd8d8.png",
          "created": "2020-08-09T13:31:14.067Z",
          "name": "RootVR",
          "serviceAccount": false,
          "urlName": null
        }
      ],
      "mergeID": null,
      "parentID": "66399d80063c114bc40a1225",
      "pinned": false,
      "postDeleted": false,
      "postID": "65725ca231648ce76efbe1b8",
