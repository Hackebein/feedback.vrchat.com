      "value": "I guess I would like this solution more if there was an easier way to use Discord in VR.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5a1c5aecb6e9dc25438660b3",
      "author": {
        "_id": "59715a9e4979f85df8d62ef5",
        "alias": "Known Mastodon",
        "aliasID": "65ba0159ed6eefce4cef07ae",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/341f9f2ecdb00dfd4d033aa53580935f.png",
        "created": "2017-07-21T01:36:30.195Z",
        "name": "tupper",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2017-11-27T18:35:24.354Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
