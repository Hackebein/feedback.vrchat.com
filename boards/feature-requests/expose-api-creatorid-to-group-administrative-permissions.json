      "statusChangeID": null,
      "value": "This would be incredibly helpful to group managers.\n\nImportantly, this data is already available in the audit log! Exposing the field in the GetGroupInstances call would reduce overall API load and eliminate race conditions for API consumers who cache data.",
      "viewerReactions": null,
      "voteID": null
    }
