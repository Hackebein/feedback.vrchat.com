      "spam": false,
      "statusChangeID": null,
      "value": "Just being able to toggle on/off the mirror using something like a contact through avatar parameters would be a massive improvement. Every time I need to toggle it I have to fumble through several layers of the radial menu while combating my thumbstick drift",
      "viewerReactions": null,
      "voteID": null
    }
