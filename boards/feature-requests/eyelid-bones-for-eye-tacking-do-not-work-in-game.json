      "statusChangeID": null,
      "value": "Just ran into this issue recently, still an issue in 2025. You need to make sure none of the rotation values you set in the descriptor are exactly zero. Probably something to do with dividing by zero.",
      "viewerReactions": null,
      "voteID": null
