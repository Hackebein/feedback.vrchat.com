      "spam": false,
      "statusChangeID": null,
      "value": "Even when I've been wishing for it for so long, the purpose of it feels like it's largely going to be defeated by forced overrides by `showAvatar` moderation and I think a majority of people would agree actually.",
      "viewerReactions": null,
      "voteID": null
    },
    {
