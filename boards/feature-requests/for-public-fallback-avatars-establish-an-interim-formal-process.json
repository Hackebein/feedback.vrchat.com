      "statusChangeID": null,
      "value": "Some additional observations:\n- avatar creators should not retain the ability to update a public fallback at any time; instead VRChat should control a \"branch\" of the package that, maybe, can get updated from the main branch when needed",
      "viewerReactions": null,
      "voteID": null
    }
