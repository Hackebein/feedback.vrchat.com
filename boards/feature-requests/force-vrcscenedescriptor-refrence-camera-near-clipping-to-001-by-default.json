      "statusChangeID": null,
      "value": "I think this canny and it's solution to the problem is obsolete: The ability to control the near clipping in the accessibility settings has been added in an update a while ago. So this is kinda solved.",
      "viewerReactions": null,
      "voteID": null
    }
