    {
      "__v": 0,
      "_id": "5f139fce7f3313128619f178",
      "author": {
        "_id": "5acd419998c0410bfee4a1f5",
        "alias": "Keen Clownfish",
        "aliasID": "65ba07f5ed6eefce4c98ed90",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/7d093f2b71d28411cc6467d1dd492cde.png",
