      "postID": "5a5bfb35f52bd1690cbabf09",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "value": "This is essential for quadruped models to have proper talk animation. Not having this option is quite absurd - blend shapes aren't rig dependent AT ALL.\n\nI recommend you to rewrite algorythm to check whether the rig is humanoid AFTER visemes are applied, if any.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5a60e38365e51e72d2beefb3",
      "author": {
        "_id": "5a60e3832478a072c83fa7ce",
        "alias": "Pink Reindeer",
        "aliasID": "65ba0213ed6eefce4c025aef",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/87b8dde596737c70bce64a542ea07379.jpg",
