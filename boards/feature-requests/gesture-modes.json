    {
      "__v": 0,
      "_id": "5d747fd98dfb281470126796",
      "author": {
        "_id": "5bad4c757aa2c43f6bc506d8",
        "alias": "Indigo Mouse",
        "aliasID": "65d4169f0129d7ae44f078b7",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/34e96d257588ce3c6f1f101a5ddcdb19.png",
        "created": "2018-09-27T21:32:37.610Z",
        "name": "frostyfrog",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2019-09-08T04:13:13.323Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 1,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
