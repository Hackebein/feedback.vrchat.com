      "reactions": null,
      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "it tries to connect for about a minute before disconnecting and it requires to reconnect many times before getting \"Too Many Requests\", which in result might take about 10 minutes before being sent to error world, it's a lot faster to just restart vrchat in this case, and \"Go Home\" button would make it a lot easier and faster. plus it would be useful to add a setting to customize timeout for request, so, people don't have to wait for so long before getting disconnected",
      "viewerReactions": null,
      "voteID": null
    }
