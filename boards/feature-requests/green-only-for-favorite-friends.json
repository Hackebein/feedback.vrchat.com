      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I came here to make this exact request, but it looks like someone beat me to it so I'm upvoting them instead. This feature would encourage people to be more social by giving them more fine tuned control over their friend list. I live on orange because most of my \"friends list\" are strangers I don't necessarily want joining me at random but I'd totally be on green or even blue for my favourites.",
      "viewerReactions": null,
      "voteID": null
