        "alias": "Ruling Cuckoo",
        "aliasID": "65deb93836dd86f1c40e8709",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/121242f69617c759869734bdd026ff95.png",
        "created": "2023-04-03T19:59:50.057Z",
        "name": "unexcept",
