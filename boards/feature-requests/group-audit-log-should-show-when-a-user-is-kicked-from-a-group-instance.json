      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "internal": false,
      "mergeID": "660cb2625fbd3bb7655c2b5e",
      "mergedPostDetails": "Group Logs should show who was kicked from the instance and who kicked them!\n\nMissing this information causes an incredible amount of unnecessary drama.\n\nIf we could simply see who done it there would be a lot less detective work, finger pointing, and false accusations.",
      "mergedPostTitle": "Group logs need to show kickers and kicked!",
