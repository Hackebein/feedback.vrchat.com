      "statusChangeID": null,
      "value": "@{62df092c5968ab44bc91eed9|full_name}: That would defeat the purpose of you instantly just starting out with your friends. I wish to AVOID that first, tedious, step.",
      "viewerReactions": null,
      "voteID": null
