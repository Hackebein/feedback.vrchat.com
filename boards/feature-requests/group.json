      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2026-10-13T03:48:50.836Z",
      "deleted": false,
      "deletedAt": null,
      "fileURLs": [],
