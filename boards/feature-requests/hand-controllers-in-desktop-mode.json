      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "value": "I second this suggestion. Even excluding emulation such as with wiimotes or Leap Motion, it's possible to have Vive/Oculus controllers without an HMD and thus makes no sense that the game turns them off in desktop mode.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5a58e96bff2caf4109b1f239",
      "author": {
        "_id": "5a58d657ff2caf4109b1f1a4",
        "alias": "Orange Toad",
        "aliasID": "65ca79eeed6eefce4c552eb6",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/b81e72db6023ea1b57abff57d454ecef.jpg",
        "created": "2018-01-12T15:37:59.113Z",
        "name": "Tommy Blom",
