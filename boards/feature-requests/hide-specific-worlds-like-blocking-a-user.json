      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Wondering if VRChat has read this feedback. With much time passed, I would still really really like to see this happen.",
      "viewerReactions": null,
      "voteID": null
