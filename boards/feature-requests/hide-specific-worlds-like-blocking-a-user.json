    {
      "_id": "6ac7dd5f7c0205fa60c5ddf8",
      "author": {
        "_id": "63691297469f06772579fe6f",
        "alias": "Sage Meadowlark",
        "aliasID": "65c28116ed6eefce4c6d7d2d",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/0958f7577d869b58b8a4407e6b9fddab.png",
        "created": "2022-11-07T14:13:43.431Z",
        "name": "Fax",
        "serviceAccount": false,
        "urlName": null
      },
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2026-10-08T18:13:51.198Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "internal": false,
      "mergeID": "6ac7dd5f7c0205fa60c5ddf8",
      "mergedPostDetails": "I think this feature might be useful for people that don't want to go to specific types of worlds that aren't covered by the default content filters. Some people, like myself, have trouble with horror worlds because they're really intense for us, but not intense enough to elicit the extreme horror tag since other people can generally handle them just fine. Some people don't like specific types of worlds like clubs or maybe they found a world with too many flashing colors and want to avoid it in the future so they don't give themselves a seizure. Would also be good for people that are trying to stop addictive behavior like gambling and need to block worlds with casino type games and people who don't want to see AI. Blocking a world wouldn't necessarily even affect a world's metrics as it would be just less people going there.",
      "mergedPostTitle": "Ability to block specific worlds",
      "pinned": false,
      "postID": "64dac0da1645d009b1ed7c41",
      "private": false,
      "spam": false,
