      "spam": false,
      "statusChangeID": null,
      "value": "@{68098a4626271974ef4d2775|full_name} Yes, this would work if that was our only moderation priority. However we also moderate avatar outfits (Our events are not 18+, no topless avis or outfits with borderline nudity). So when only one moderator is present, they need to be able to see avatars on full at all times.",
      "viewerReactions": null,
      "voteID": null
    }
