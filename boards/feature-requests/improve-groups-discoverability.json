    {
      "_id": "63d00b025956490f0233857e",
      "author": {
        "_id": "604af146155eb70d8d4d5a1f",
        "alias": "Empty Moose",
        "aliasID": "65c2a286ed6eefce4c72d251",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/ade3a62c60c5e56293c48e37a7b03576.png",
        "created": "2021-03-12T04:42:46.191Z",
        "name": "Fusl",
        "serviceAccount": false,
        "urlName": "katie-holly-1"
      },
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-01-24T16:44:50.900Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "internal": false,
      "mergeID": "63d00b025956490f0233857e",
      "mergedPostDetails": "We have groups currently and that's great, but it's sometimes hard to find groups to join, or have people find the groups I've created. Why not have a search function either on the site or in-game that lets you search a name, tag, or keyword and pull up all of the groups relating to that search, like we have for our world search? \n\nImagine if you want to look for a movie group so you type in the word \"movie\", then you could see every movie group there is in VRChat and pick which one would be best for you! I love the idea of groups and I think they're a step in the right direction for people new to VRChat or people who want to make more friends with similar interests, but walking around, world hopping, and meeting people at random to hope that you find a group you like isn't much better than what we were doing to begin with. Why not make it a little easier to find people and make friends and just search for people with similar interests?",
      "mergedPostTitle": "Ability to search for groups",
      "pinned": false,
      "postID": "6388503c87ad14540382a2fa",
      "private": false,
      "spam": false,
      "synthetic": true,
      "value": ""
    },
