        "avatarURL": "https://canny-assets.io/images/c2ae015decb4ebbf53b95f52749ef946.png",
        "created": "2023-12-25T23:59:41.281Z",
        "name": "Nexal",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2024-05-31T23:40:04.633Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
