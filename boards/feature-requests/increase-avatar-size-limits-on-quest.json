      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Personally I'd like to see the compressed size raised from 10mb, keep the 40mb uncompressed size for now, but ASTC textures are not as compressible in download bundles, especially if someone is being smart with the block size options.",
      "viewerReactions": null,
      "voteID": null
