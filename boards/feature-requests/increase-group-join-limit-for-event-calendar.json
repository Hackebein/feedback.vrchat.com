      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-08-30T10:41:54.688Z",
      "deleted": false,
      "deletedAt": null,
