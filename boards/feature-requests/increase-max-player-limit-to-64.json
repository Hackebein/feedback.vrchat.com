      "pinned": false,
      "postDeleted": false,
      "postID": "5d9b713d613a5739f035d7ad",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Here's one idea to improve optimization for many users. Force all actors beyond the 39 closest players to a lower-quality tracker with minimal CPU and GPU usage. Do not play audio or display markers. When actors are detected within range, they can switch back to the standard systems and appear. This way it's only a marginal CPU cost to maintain locations of actors, but they don't need to be referenced until they're close to the player.",
      "viewerReactions": null,
      "voteID": null
    }
