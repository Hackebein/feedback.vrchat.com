      ],
      "mergeID": null,
      "parentID": "62ac93d83752c50ba6a66f14",
      "pinned": false,
      "postDeleted": false,
      "postID": "62ab1b64b3a6400bb37eee0d",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{5f7357906c3d6c58f8b14466|full_name}: The reason that youtube is \"limited\" to 720 is because that is the highest resolution that youtube will provide a combined audio+video link.\n\nAll higher resolutions from youtube are split between 2 links, one for audio and one for video. There is no mechanism yet for being able to handle those separate links, nor is DASH format supported yet.\n\nTLDR; technical reasons why 720 is the limit for YT and, yet again, it's mainly YT's fault.",
      "viewerReactions": null,
      "voteID": null
    }
