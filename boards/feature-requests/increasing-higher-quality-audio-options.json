      "statusChangeID": null,
      "value": "Playing piano in VRC sounds mediocre since the audio gets mixed down to mono. Having the ability to click on a person and set their audio to stereo and/or increase their audio quality would be hugely beneficial for performers in VRC",
      "viewerReactions": null,
      "voteID": null
    }
