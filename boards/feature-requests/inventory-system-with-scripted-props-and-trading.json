        "aliasID": "65c288dbed6eefce4c9b51ee",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/e2693a8415cafaeb7dfd09dc3ffa06c5.png",
        "created": "2021-04-26T16:02:20.131Z",
        "name": "frou01",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2024-09-02T12:10:35.497Z",
      "deleted": false,
      "fileURLs": [],
