      "statusChangeID": null,
      "value": "I was going to suggest this for performance reasons. No reason to load unload assets that are persistent between load zones. Unless there is a technical reason to do so behind the scenes. It makes no sense to unload something you are immediately going to use again.",
      "viewerReactions": null,
      "voteID": null
    }
