      "spam": false,
      "statusChangeID": null,
      "value": "It's easy to use a toggle system without legacy animations, and to reset a wordspace object you just need to reset the joint position and rotation while the joint is turned off. Legacy animations are useful but not for this",
      "viewerReactions": null
    }
