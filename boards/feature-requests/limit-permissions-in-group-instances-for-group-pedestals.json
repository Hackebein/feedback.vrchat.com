      "statusChangeID": null,
      "value": "@{6283e1007316fe0b7ef81f7f|full_name}  The language is pretty clear in the request but to clarify...  Group Pedestals is the focus rather than Portals.  When you drop authorized group pedestals other folks see it as an invitation to do such and it gets messy fast.",
      "viewerReactions": null,
      "voteID": null
    }
