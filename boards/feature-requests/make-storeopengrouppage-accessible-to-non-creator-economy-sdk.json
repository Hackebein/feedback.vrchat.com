      "spam": false,
      "statusChangeID": null,
      "value": "It's included in 3.5.1 and not restricted. All other economy features are also in the public sdk, but those can't be used ingame without economy access. Here's a simple example script designed to be triggered by a canvas button, as the function hasn't been too well documented:\n\nusing UdonSharp;\n\nusing UnityEngine;\n\nusing VRC.SDKBase;\n\nusing VRC.Udon;\n\nusing VRC.Economy;\n\n[UdonBehaviourSyncMode(BehaviourSyncMode.None)]\n\npublic class GroupOpener : UdonSharpBehaviour\n\n{\n\n    public string GroupID = \"\";\n\n    \n\n    public void _OpenGroup()\n\n    {\n\n        Store.OpenGroupPage(GroupID);\n\n    }\n\n}",
      "viewerReactions": null,
      "voteID": null
    }
