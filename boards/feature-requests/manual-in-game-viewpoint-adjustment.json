      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Expecially when lying down the viewpoint breaks, there should either be manual ingame adjustment or vrchat sdk option to set per body poisition view points, e.g. standing, crounch, prone.",
      "viewerReactions": null
    },
