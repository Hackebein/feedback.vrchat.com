        "like": 2
      },
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It would also be great if there were an option to automatically block untrusted URLs in Public instances. Stumbling into a malicious world seems much less likely than stumbling into a malicious user in a trustworthy world.",
      "viewerReactions": null,
      "voteID": null
    }
