      },
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "In popular worlds that have a video player, I see more and more often people putting shocking/NSFW videos on the video player, those videos usually come from an untrusted URL (so not YouTube).\n\nHaving a world-based \"Untrusted URL\" setting could improve this issue.\n\nMaybe having a \"Allow Untrusted URLs\" option on the VRCUrl component could also help.\n\nThis won't fix the issue, but probably improve it.",
      "viewerReactions": null,
      "voteID": null
    },
