      "statusChangeID": null,
      "value": "VRChat is planning to let world creators use Udon hooks to add their own UI to the quick menu. This will let us do custom audio slider and much, much more! https://medium.com/vrchat/vrchat-april-2021-dev-stream-recap-8502bb8c9163",
      "viewerReactions": null
    }
