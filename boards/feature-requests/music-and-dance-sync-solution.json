      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{59b9afc4e46c3651b53cf856|full_name}: A solution to what OP suggests is just playing the song at the same time individually. Get on a youtube syncing site or Spotify listen together, or go on Discord and \"3 2 1 go\" it. If you hear the same song at the same time locally and dance to it you and your partner dancing will be in sync to anyone watching, even if it looks off to each other.",
      "viewerReactions": null
    }
