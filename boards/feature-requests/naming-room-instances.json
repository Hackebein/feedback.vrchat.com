      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It would be even more useful if the world itself could control the name too. Such as long-game worlds having its status shown as part of the instance name or a description field.\n\nBut this is likely more useful in a dynamic description field, rather than part of the instance ID.\n\nFor example, some game or puzzle worlds have no late-joiner support. So the world would write \"in progress\".",
      "viewerReactions": null,
      "voteID": null
    },
