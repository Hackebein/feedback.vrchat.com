      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This change will negatively impact my experience and that of my friends. There are already plenty of options to control the behavior of people in private (friends, invite, friends+, invite+) -- adding a restraint like this is wholly unnecessary and will make some worlds already scaled for larger or smaller sizes useless if we can't reach the world author's desired scale and it leaves no options for those of us in private worlds to do as we would like.",
      "viewerReactions": null,
      "voteID": null
    },
