      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "They need to add a button to see your own avatar with shaders and animations disabled. Most broken meshes you see around are because of animations disabled, but the avatar owner doesn't see that because is always like \"Enabled\".",
      "viewerReactions": null,
      "voteID": null
    }
