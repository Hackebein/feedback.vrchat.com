      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": "639ba8a3544edd7976e6e565",
      "mergedPostDetails": "I want to appear offline even if I'm not. That's the whole post. Tupper has said elsewhere \"We have DND mode so we won't add an invisible mode\" but that doesn't do what we want at all. People still see me as online, they just can't join. I have ~1,000 friends and I'd really appreciate this feature.",
      "mergedPostTitle": "Can we PLEASE have an \"invisible\" offline mode?",
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "62492a2718cd495298ef21d5",
      "private": false,
      "reactions": {
        "like": 5
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I find this really counter-productive for VRChat. It's a socializing game, not a \"hide from your friends\" kind of game.\n\nThere's more important things that need to be added than this.",
      "viewerReactions": null,
      "voteID": null
    },
