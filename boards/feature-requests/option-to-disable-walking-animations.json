      "spam": false,
      "statusChangeID": null,
      "value": "The new avatar descriptor option \"Force Locomotion animations for 6 point tracking\" when disabled effectively provides this function, but only for self-uploaded avatars.\nI still want this option ingame, so that I can have this functionality with any public avatar as well.\nThis functionality is valuable when using Natural Locomotion as well as treadmills, or any other creative applications.",
      "viewerReactions": null
    }
