      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I've just tested this on my 3700X and I seem to have opposite results. Restricting to a single CCX reduces my performance slightly.",
      "viewerReactions": null
    },
