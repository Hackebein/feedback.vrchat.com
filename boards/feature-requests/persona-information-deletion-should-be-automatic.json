      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I agree with OP, it should be automatic regardless. Then again, it's Persona; they've already been hacked twice, and people's data is out there somewhere for who knows out there to use.",
      "viewerReactions": null,
      "voteID": null
    }
