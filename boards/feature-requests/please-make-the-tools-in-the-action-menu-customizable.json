      "spam": false,
      "statusChangeID": null,
      "value": "Came here to suggest this! I change my mirror options (specifically \"Grabbable\" and \"Masking\") constantly, really wish I could have them handy in my tools menu alongside the mirror toggle",
      "viewerReactions": null,
      "voteID": null
