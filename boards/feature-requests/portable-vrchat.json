      "statusChangeID": null,
      "value": "This just isn't possible to run on the typical mobile device due to the fact the a PC isn't able to run it. Most phone don't have the power to run the game, Even in a minimized state.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5b50e07418ffed69bd0ad79b",
      "author": {
        "_id": "59c0e5cd39a9874475bcbfd7",
        "alias": "Peach puff Impala",
        "aliasID": "65ba0170ed6eefce4cf19ab9",
