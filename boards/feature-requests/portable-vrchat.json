        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-07-19T19:03:16.574Z",
      "deleted": false,
      "fileURLs": [],
