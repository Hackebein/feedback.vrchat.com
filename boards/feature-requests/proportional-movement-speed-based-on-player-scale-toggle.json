      "statusChangeID": null,
      "value": "There's a few suggestions for similar ideas, however they aren't exactly the same as this one and are solving slightly different issues. They can be found here:\n\nhttps://feedback.vrchat.com/feature-requests/p/different-movement-speeds-based-on-model-size\n\nhttps://feedback.vrchat.com/feature-requests/p/variable-player-run-speed",
      "viewerReactions": null,
      "voteID": null
    },
