      "spam": false,
      "statusChangeID": null,
      "value": "Bumping this up, this would be incredibly useful in letting avatar creators have some sort of fallback system in place if shaders are disabled to keep avatars from breaking",
      "viewerReactions": null,
      "voteID": null
    }
