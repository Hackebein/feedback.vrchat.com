      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It would be an easy solution to just set the upload size to \"unlimited\" and have the quest client decide how small the avatar has to be in order to be downloaded.",
      "viewerReactions": null,
      "voteID": null
    }
