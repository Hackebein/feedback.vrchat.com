      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "The game is haemorrhaging new players due to gaping security flaws like this and others. The majority of long time active VRC players aren't in the VRC discord to get directed to the website, let alone the average new player. Public instances have turned into a client users war zone. The problem is only pushing players towards using modded clients themselves in order to mitigate the problem, and thus making the situation worse.",
      "viewerReactions": null
    }
