        {
          "_id": "63cbea337d46b409827e402a",
          "alias": "Above Kingfisher",
          "aliasID": "65c28a47ed6eefce4cd1ced9",
          "anonymized": false,
          "avatarURL": "https://canny-assets.io/images/b8c15830c5f364274a2e49c8b4019934.png",
          "created": "2023-01-21T13:35:47.645Z",
