      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2026-10-31T21:17:19.038Z",
      "deleted": false,
      "deletedAt": null,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
