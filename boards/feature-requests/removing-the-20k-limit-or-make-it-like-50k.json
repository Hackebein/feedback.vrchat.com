      "spam": false,
      "value": "The team at VRChat is not only small but is also limited by the Unity engine. It's not as simple as you're making it out to be in your post.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5b44e6b974eab24007840d6c",
      "author": {
        "_id": "5b2eb0e58531a572169bcd8f",
        "alias": "Jonquil yellow Crawdad",
        "aliasID": "65c319f5ed6eefce4c73da95",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/e3a1bcf53b1e7cc208498af743352f52.jpg",
        "created": "2018-06-23T20:43:17.849Z",
