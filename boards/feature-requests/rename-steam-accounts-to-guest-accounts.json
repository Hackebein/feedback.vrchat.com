      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "The VRChat account automatically created when an user log in with the Steam account or Oculus account cannot have its Display Name changed, and will remain after account consolidation and will continue to appear in account searches indefinitely. The Steam username or Oculus username should not be included in the Display Name of an automatically created VRChat account.\nThe Oculus account username can only be changed once every 6 months, making it difficult to change the username in advance or take other measures, making it more problematic.\nhttps://store.facebook.com/help/quest/articles/accounts/account-settings-and-management/change-oculus-username/",
      "viewerReactions": null,
      "voteID": null
    }
