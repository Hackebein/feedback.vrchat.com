      "mergeID": "5ca2a15303326d7eea114132",
      "mergedPostDetails": "Allow for a direct report against a player in your room. Reports could be more based on various buttons such as avatar stealing, client side hacking, and verbal harassment. This will allow for a more direct push to report users that otherwise ruin the experience of VRChat as a whole for the community.",
      "mergedPostTitle": "Extensive In Game Report System",
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "5a3dfb134a8da67427803df2",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "value": "It is my understanding that most moderation reports require detailed descriptions and evidence concerning the infraction being reported. Ingame reporting with just a few button presses would do little to support that and would only open up another pathway for system abuse.",
      "viewerReactions": null
    },
