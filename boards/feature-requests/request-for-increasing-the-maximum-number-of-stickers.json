      "statusChangeID": null,
      "value": "It would be wonderful if shared stickers wouldn't count to the “upload” limit and instead a different maximum limit, too.\n\nEspecially since they do not take up the same amount of bandwidth.",
      "viewerReactions": null,
      "voteID": null
    }
