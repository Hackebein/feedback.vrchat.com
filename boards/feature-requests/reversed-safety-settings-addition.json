      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Another thing I forgot to add is that it allows for the user's model not to be automatically cached to whoever is loading it, fixing multiple problems with avatar stealing.. which I have been most concerned about for years.",
      "viewerReactions": null
    }
