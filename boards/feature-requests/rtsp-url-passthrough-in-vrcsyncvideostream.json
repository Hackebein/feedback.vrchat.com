      "spam": false,
      "statusChangeID": null,
      "value": "P.S.\nHLS streaming from your PC can use VRC_SyncVideoStream, but it has at least 5 seconds latency. We use RTSP to get sub-second latency for avatar movement matching and communicating through audio streams.",
      "viewerReactions": null
