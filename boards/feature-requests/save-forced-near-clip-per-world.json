      "spam": false,
      "statusChangeID": null,
      "value": "Thank you for being one of the very few people asking for this setting that understand that it has the potential to be extremely damaging to the presentation and function of worlds with long sight lines or large distances. Unfortunately, VRChat decided to implement the persistence of this setting without regard to how it would impact worlds.",
      "viewerReactions": null,
      "voteID": null
    }
