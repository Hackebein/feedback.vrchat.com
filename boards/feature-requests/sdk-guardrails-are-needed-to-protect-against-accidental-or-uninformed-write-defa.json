      "spam": false,
      "statusChangeID": null,
      "value": "It should be either ON in all controllers, or OFF in all Controllers, you should not Mix them, else it'll break avatar animations.\nMine have them On and seem to not have issues with avatar hider or anything else.",
      "viewerReactions": null,
      "voteID": null
