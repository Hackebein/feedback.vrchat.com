      "statusChangeID": null,
      "value": "I'm guessing you've somehow never noticed the \"Server Processing\" message that shows up when someone uses an avatar that hasn't been used in awhile? This is because they periodically recheck avatars.",
      "viewerReactions": null,
      "voteID": null
    }
