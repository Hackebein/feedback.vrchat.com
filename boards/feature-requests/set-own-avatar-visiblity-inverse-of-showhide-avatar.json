      "spam": false,
      "statusChangeID": null,
      "value": "I think this is a bad idea unless the specially shown avatar is opted in by both people.\n\nIf I'm Person B in this scenario and I don't know Person A, I don't want to unexpectedly see something else from everyone else in the room. I just want to see your fallback, I do not want to be on the receiving end of how this will be abused.\n\nBut yeah if I also have to opt in to see your special avatar, that could mitigate the abuse a bit.",
      "viewerReactions": null,
      "voteID": null
    }
