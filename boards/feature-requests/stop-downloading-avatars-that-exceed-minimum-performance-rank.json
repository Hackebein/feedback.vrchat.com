      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "There's a problem with this.\nVRChat calculates the performance rank locally when the avatar loads, there's nothing on the server storing the avatar's performance rank.\nThis makes it impossible to know the rank before it loads sadly.\nBut yea seems like you're aware, just pointing it out.",
      "viewerReactions": null,
      "voteID": null
    },
    {
