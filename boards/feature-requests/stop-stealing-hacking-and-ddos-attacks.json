      "statusChangeID": null,
      "value": "I generally agree with what you're saying, however the private avatar feature already works the way you want it to. You cannot load into a private avatar that isn't tied to your account, the avatar simply won't load. People can still rip your avatar and re-upload it but they can't switch into the private version tied to your account",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5d51ae0ed321395664bcd703",
      "author": {
        "_id": "5c175484388e623ba8a94131",
        "alias": "Enchanting Cheetah",
        "aliasID": "65c72e72ed6eefce4c6cb186",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/c5f06d19d793e20c5fb7f1ec1d415c65.png",
        "created": "2018-12-17T07:47:16.246Z",
        "name": "LaFont",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2019-08-12T18:21:02.471Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
