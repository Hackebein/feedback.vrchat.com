      "spam": false,
      "statusChangeID": null,
      "value": "@{5ae015630918096e725040b5|full_name}: the script that allows animator toggling only allows unity to not be retarded, it literally is a fix for the weird way unity jerks your options around and isn't attached to your avatar when uploaded.\n\nIts just a unity fix, not a scripted \"hack\".",
      "viewerReactions": null
