      "postID": "5a5da9f5af44d4283ed387c4",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "value": "This would be similar to having first-class props, since I could put each prop on a different animation override controller. At the moment I am uploading multiple copies of the same avatar and switching between them, which I'm sure isn't great for bandwidth usage.",
      "viewerReactions": null
    },
    {
