    {
      "__v": 0,
      "_id": "62f320eaafc94f449bc2ded3",
      "author": {
        "_id": "5f2dd2e88950d37cd0800366",
        "alias": "Used Platypus",
        "aliasID": "65c2f488ed6eefce4c85f054",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/2c0cc3300782dc139c98a79bf3769a43.png",
        "created": "2020-08-07T22:17:12.097Z",
