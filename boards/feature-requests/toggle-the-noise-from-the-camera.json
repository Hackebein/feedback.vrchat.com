      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This is very important for video recording due to two things:\n\n1) A pattern of the noise is static and the same across multiple frames. That's not how the real film grain behaves and it is hard to remove even in post production using denoising tools.\n\n2) We don't have any aperture control, so most of recordings in darker worlds are unusable when you try to brighten them up in post production.",
      "viewerReactions": null,
      "voteID": null
    },
