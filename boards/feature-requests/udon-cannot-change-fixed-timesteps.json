      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "The document (https://docs.vrchat.com/docs/event-execution-order) states \"Matches the user's screen refresh rate\" but does not mention any reason for this. What are the advantages of this specification and why is it adopted? I don't think it is good that different users get different physics results.",
      "viewerReactions": null,
      "voteID": null
    },
