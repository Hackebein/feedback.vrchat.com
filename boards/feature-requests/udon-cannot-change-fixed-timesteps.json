      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "By not allowing this to be set to a fixed rate, this makes worlds both run worse & introduces glitches caused by feedback being framerate-dependent. This introduces two massive issues: it breaks any program that relies on the expectation of the timestamp being fixed, & it prevents any game that relies on this function from being fair & balanced due to the inability for the fixed timestamp to be consistent.\n\nVRChat please fix.",
      "viewerReactions": null,
      "voteID": null
    },
