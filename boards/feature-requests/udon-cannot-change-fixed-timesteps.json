      "spam": false,
      "statusChangeID": null,
      "value": "Lowering the fixed timestep rate would allow us to improve the performance of our worlds. It would also let us avoid physics issues caused by very low or very high refresh rates.\nUnity has built-in interpolation feature for rigidbodies, so their movement would continue to appear smooth.\nPossibly this affects avatars negatively. Not sure.",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "6463c906508dba08febae2d7",
      "author": {
        "_id": "5d09f39124a63950e4b890dc",
        "alias": "Mixed Eagle",
        "aliasID": "65c2b4a2ed6eefce4ce0c4b0",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/3e92ac66c3eda8fc68e4b2a11ce28b3f.png",
        "created": "2019-06-19T08:34:25.884Z",
