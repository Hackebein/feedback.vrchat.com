      "spam": false,
      "statusChangeID": null,
      "value": "This is the way it is for security reasons. Allowing runtime URLs allows for data exfiltration, user tracking, logging of avatar ids, ect. It would be a privacy nightmare.",
      "viewerReactions": null,
      "voteID": null
    }
