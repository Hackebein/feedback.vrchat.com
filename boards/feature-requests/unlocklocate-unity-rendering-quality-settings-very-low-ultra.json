      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{5ab3ad272b67505f726c2a8f|full_name}: They don't even have to script it ingame! Unity allows for you (the dev) to set what graphics quality options the user can use when launching it! It makes no sense why they haven't done it yet.",
      "viewerReactions": null
    }
