      "statusChangeID": null,
      "value": "This has the added benefit of stopping hackers.\n\nTraditionally what they would to is find loopholes. This would be much harder to do if the metric was performance bases instead or rule based, because there would be no loophole to find. They can't get away with making 1000000 invisible particles, or using an absurd amount of draw calls despite being under the poly limit. This would make the system generally harder to exploit.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5b43c2c33dece268bd35c27c",
      "author": {
        "_id": "5a6c4d4edb821e1569d46de3",
        "alias": "Continuing Ant",
        "aliasID": "65ba0267ed6eefce4c0abe52",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/04fd5a4de619c92e46f8194f71a82698.png",
        "created": "2018-01-27T09:58:38.732Z",
        "name": "Darksunrise",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-07-09T20:17:07.745Z",
      "deleted": false,
      "fileURLs": [],
