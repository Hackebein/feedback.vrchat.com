      "spam": false,
      "statusChangeID": null,
      "value": "Agree, this is an important and essential part of being able to actually test our own uploads.\n\nI don't own a quest nor a phone that can play vrchat mobile. Only a VR-ready PC.\n\nNot being able to test this is another reason I put no effort to make quest content, because I literally have no means.",
      "viewerReactions": null,
      "voteID": null
    }
