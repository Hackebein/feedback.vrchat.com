      "spam": false,
      "value": "This would be really useful! I use hand gestures to change the emotion of my avatar's face, and when I go into VR mode (I've been trying it with a carboard VR glasses + an android APP, so no hand controllers) the animation I've set to alt+F3 is always activated, which is pretty weird, and I have no way to change it. All the desktop features should be avaliable in VR mode, because as much as us desktop users love that the devs care about us, it's weird that VR users lack some functions like these.",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5ad99c53d710fb02e823ee30",
      "author": {
        "_id": "5ad9990a48df831d2dd54abe",
        "alias": "Jasper Beetle",
        "aliasID": "65ba090ced6eefce4cb5dd7d",
        "anonymized": false,
        "avatarURL": null,
        "created": "2018-04-20T07:38:50.915Z",
        "name": "FEFELAND",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "58c62efae9868f3662e9d9a1",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-04-20T07:52:51.933Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "likeCount": 0,
      "mentionedUserIDs": null,
