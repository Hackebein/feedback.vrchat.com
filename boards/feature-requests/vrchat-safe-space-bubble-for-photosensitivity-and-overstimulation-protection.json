      },
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "One of my good friends here on vrc has epilepsy and it's heartbreaking seeing him go down. I have my own protocol whenever I see him drop, but it would be nice to see a feature implemented to help reduce epileptic fits and allow vrc to be even more inclusive.\n\nAdditionally, I think a content warning tag of \"flashing lights\" could help out some of our photosensitive players know before they load into a world.",
      "viewerReactions": null,
      "voteID": null
    }
