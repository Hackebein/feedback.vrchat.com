        "like": 1
      },
      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Currently, if a user who already reached the maximum number of groups sends a join request, the group moderators receive the request but cannot approve it.\n\nThe error only appears when moderators try to accept the request.\n\nThis seems backwards from a UX perspective.\n\nInstead, the system should check the group limit when the user sends the join request and prevent the request from being sent in the first place.\n\nShowing an error message like:\n\n\"You cannot request to join this group because you have reached the maximum number of groups.\"\n\nwould prevent unnecessary requests and confusion for both users and moderators.",
      "viewerReactions": null,
      "voteID": null
    },
