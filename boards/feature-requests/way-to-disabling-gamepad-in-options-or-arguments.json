      "postDeleted": false,
      "postID": "62ad12660ac4f12290c3cd67",
      "private": false,
      "reactions": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I like to have VRChat open while I play other games, and I cannot use a controller because of this issue. VRChat, even when unfocused, reads all of my controller inputs. I would really like to be able to play other games with a controller while I have VRChat open. Having an option to disable controller input would be an absolute godsend.",
      "viewerReactions": null,
      "voteID": null
