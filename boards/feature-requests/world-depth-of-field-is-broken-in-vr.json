      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "An SDK warning would be nice. Or maybe you could generally disable it for VR? I mean there is no use for it as far as i know in VR, just breaks things.\n\nI have quite a few worlds that look absolutely amazing, but being in there for more than 5 minutes in VR gives you a headache because of the depth of field effect being broken D:",
      "viewerReactions": null,
      "voteID": null
    }
