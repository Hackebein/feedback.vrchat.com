      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "The way it is saved in the Files app seems to mirror the way it's done on the Windows version.\n\nIt seems to get saved in both places now but I can't find a setting to configure it to save in only one or the other.",
      "viewerReactions": null,
      "voteID": null
    }
