      "statusChangeID": "60076c788ef17279fbcbcc8c",
      "statusChangeNewStatus": "closed",
      "value": "We're aware of the issues with changing behavior with people's avatars-- this is a valid concern!\nHowever, asking users to reupload when there's no real reason to doesn't seem fair either.\nWe will communicate as best as possible to our users that parameters on AV3 avatars will now be saved by default.",
      "viewerReactions": null
    }
