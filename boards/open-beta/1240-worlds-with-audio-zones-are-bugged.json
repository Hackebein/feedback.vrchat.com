      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This is very likely related to the AudioZones used in Guribo's package. This is likely a duplicate of https://feedback.vrchat.com/open-beta/p/1240-worlds-with-audio-zones-are-bugged , however they don't mention how streams break.",
      "viewerReactions": null,
