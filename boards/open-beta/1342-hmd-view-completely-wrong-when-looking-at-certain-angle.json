        "_id": "5f36189090a4f27bd3021255",
        "alias": "Broad Lamprey",
        "aliasID": "65c287a4ed6eefce4c6c0a28",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/7fdfe7807f398a628385c5c2cb04396d.png",
