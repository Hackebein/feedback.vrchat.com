      "spam": false,
      "statusChangeID": null,
      "value": "Can confirm this is also happening for be on the Unity 2022 beta. Notably both the finger AND palm colliders don't work for me, meanwhile you said the palm works but fingers don't?",
      "viewerReactions": null,
      "voteID": null
    }
