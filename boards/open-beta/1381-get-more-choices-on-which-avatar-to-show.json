      "spam": false,
      "statusChangeID": null,
      "value": "I agree with this except for the fact that fallback and impostor are separated, I think those should be lumped into one overarching \"fallback\" option that respects whatever the user would look like if performance blocked or unavailable. \n\nIt feels wrong that you'd be able to force someone's appearance into a fallback if they personally have the impostor-over-fallbacks setting enabled, disrespecting the way they'd like to be seen.",
      "viewerReactions": null,
      "voteID": null
    }
