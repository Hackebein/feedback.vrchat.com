      "spam": false,
      "statusChangeID": null,
      "value": "@{5f30ecee654cd4491456a82f|full_name}: Our thinking is that at least at this stage, adding overrides would hamper healthy development of the driver ecosystem, so for now we'll rely on the SteamVR spec and give a chance for driver devs to issue updates and influence how VRChat interprets hand data through the official SteamVR spec for skeletal bindings.",
      "viewerReactions": null,
      "voteID": null
    }
