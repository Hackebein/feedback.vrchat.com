      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": "66a2dc5f880a6abb1e35b604",
      "statusChangeNewStatus": "closed",
      "value": "This is expected behavior and is down to VRChat respecting the driver's skeletal fidelity level. If it's \"full\" then pinch input will be active, and otherwise it won't be. The new beta of Virtual Desktop allows switching in their new driver between full and estimated skeletal fidelity and should work well for swapping between controllers and hands.\n\nALVR does not specify the skeletal fidelity as \"full\" so pinch input is not active. (We still use partial and estimated skeletal fidelity to animate the avatar's fingers so that will still function with ALVR)",
      "viewerReactions": null,
      "voteID": null
    },
