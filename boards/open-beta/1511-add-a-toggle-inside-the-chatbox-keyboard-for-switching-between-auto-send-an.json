      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I'd also like to offer that a keybind in SteamVR bindings would also be a decent compromise if this is a matter of UI complexity. Please just somehow give us a convenient way to switch between both.",
      "viewerReactions": null,
      "voteID": null
    }
