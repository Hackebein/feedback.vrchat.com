      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Sticky pickups are proving to be an accessibility hindrance when they not wanted. If this is going to be an automatic thing it absolutely must take user configuration into account and be overridable in client. If this is about Vive Wands, consider that the wand controllers have completely different inputs and things applicable to them may be categorically irrelevant to all other VR controllers.",
      "viewerReactions": null,
      "voteID": null
    },
