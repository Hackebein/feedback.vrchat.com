      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It's still annoying to have to deal with this being forced onto me. I've had to forcibly disable autohold on all of the pickups in my own worlds when in VR. My opinion on this has not changed since its addition",
      "viewerReactions": null,
      "voteID": null
    },
    {
