      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "There's no free lunch, every single stat in the performance rank effects performance. There's already clear guides on what those limits are. We don't need every user to make up their own standards on what's acceptable.",
      "viewerReactions": null,
      "voteID": null
