      "spam": false,
      "statusChangeID": null,
      "value": "VRChat 2026.3.1 (OPEN BETA) July 29, `Build 1880`:\n\n> The option to show/hide Age Verification status in the Edit Profile modal no longer appears for users younger than 18.\n\nhttps://docs.vrchat.com/docs/vrchat-202623-openbeta#user-profiles-1",
      "viewerReactions": null,
