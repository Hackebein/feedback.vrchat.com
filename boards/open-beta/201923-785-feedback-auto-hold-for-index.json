      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Right now the gripping value seems like it's a little high. Holding something for a long period of time without accidentally dropping it would get pretty exhausting. :)",
      "viewerReactions": null
    },
