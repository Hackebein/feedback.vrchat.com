      "mergeID": "6a7353c856d0de7a2d1069bc",
      "mergedPostDetails": "I am using the Unity-6 beta, and I am stuck on the connecting screen when logging in",
      "mergedPostTitle": "stuck on connecting",
      "parentID": null,
      "pinned": false,
