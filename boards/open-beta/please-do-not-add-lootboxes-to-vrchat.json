      "mergeID": null,
      "parentID": null,
      "pinned": true,
      "postDeleted": false,
      "postID": "6849c70592dbbd68c9bd14df",
      "private": false,
      "reactions": {
        "like": 3
      },
      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "We are not planning on implementing loot boxes into VRChat. In VRChat, \"Bundles\" are packs of items you get together, and have no inherent randomization or \"percent droprate\" mechanic. They will always contain the same thing for anyone that receives them. There is zero chance or gambling element built into them, and in fact there is no support built into the system for such a mechanic.\n\nThese content drops will be first used as a benefit to users that participate in the Pride Charity campaign in June, but will also be leveraged soon as a VRC+ benefit -- every month, you'll get a box full of stuff. Everyone gets the same box, with the same stuff.\n\nVRChat Bundles are a means of delivering content to users without overriding their agency to accept or reject that content.\n\n(I'll close this post later once the Beta goes live)",
      "viewerReactions": null,
      "voteID": null
    },
