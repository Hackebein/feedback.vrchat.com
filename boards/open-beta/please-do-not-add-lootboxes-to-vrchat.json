      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I think if vrchat want to stick with the idea of seasonal stickers and stuff a better solution is to add them to the users inventory automatically and possibly give them a notification that they have gotten new stickers for example. The way it is presented right now makes it indistinguishable from a lootbox, even if vrchat doesn't intend for it to be.",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "6849db4e410db8a9ae1b2ced",
      "aiGenerated": false,
      "author": {
        "_id": "5acad9ecc9dba010c9c3ec68",
        "alias": "Evolutionary Vicuna",
        "aliasID": "65ba088fed6eefce4ca8dc62",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/a96149971e91f0ceb638e9e86cef2b08.gif",
        "created": "2018-04-09T03:11:40.225Z",
        "name": "Tupper - VRChat Head of Community",
        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "5b0746088fa72313783e3269",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-06-11T19:38:54.163Z",
      "deleted": false,
