      "statusChangeID": "648376a373bbf616bbe81a91",
      "statusChangeNewStatus": "complete",
      "value": "This has been fixed, but it's not that straightforward. @{62034685cf5a700b540f438a|full_name}'s chill home was using a configuration which we did not expect or plan to support, but we have re-enabled it with some caveats in order to support old worlds that cannot be re-uploaded.\n\nNote that using a permanently disabled VRC_UiShape to turn on raycasting against an active canvas is considered legacy behavior. For now it will work, but it may degrade UI performance. You should always ensure that VRC_UiShapes are enabled when supposed to be in use.",
      "viewerReactions": null,
      "voteID": null
    }
