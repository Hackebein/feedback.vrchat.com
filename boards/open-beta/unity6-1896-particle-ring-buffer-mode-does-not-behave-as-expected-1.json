          "serviceAccount": false,
          "urlName": null
        }
      ],
      "mergeID": null,
      "parentID": "6a8de1860e8c4c8b0cf9e402",
      "pinned": false,
      "postDeleted": false,
      "postID": "6a8637d98c092ddc7ff769a9",
      "private": false,
      "reactions": null,
