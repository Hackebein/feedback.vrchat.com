          "name": "Truce",
          "serviceAccount": false,
          "urlName": null
        }
      ],
      "mergeID": null,
      "parentID": "673f44318f856813fe24fae2",
      "pinned": false,
      "postDeleted": false,
      "postID": "673d72d6889c91ceb6c045b1",
      "private": false,
      "reactions": {
        "like": 1
      },
      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "@{654a7d1f1870ff9faf0911e8|full_name} \n\noh, it took me a minute after writing the above standalone comment, but i believe i know what causes it.\n\npreviously cache folders were created in an alphabetical order, so tools removing older versions had to keep just the \"greatest\" one after sorting them by name.\n\nnow this naming system changed (see my above screenshots) and it may cause the newer version's folder to be alphabetically \"earlier\"/\"lower\", so the aforementioned tools delete it, causing it to be missing and getting redownloaded during the next session.\n\ncheers.",
      "viewerReactions": null,
      "voteID": null
    },
