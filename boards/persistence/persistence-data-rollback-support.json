        "avatarURL": "https://canny-assets.io/images/e3b20c0f542d2fa16b689a45032814e0.png",
        "created": "2021-02-13T15:56:32.244Z",
        "name": "Mixieǃ",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "66219a23aca51fa0303952e3",
      "companyID": "58c62e995865713647a7115d",
      "created": "2026-01-22T12:25:52.474Z",
      "deleted": false,
