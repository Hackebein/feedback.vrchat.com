      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "So is the \"less than a tenth of a floppy disk\" persistence storage space per-user per-world the result of server bandwidth costs OR the result of persistent data being inexplicably inherently udon synced (when it doesn't need to be?) lmao",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "_id": "6952c4233e01b0e33abf6fb1",
      "aiGenerated": false,
      "author": {
        "_id": "5f3287055bc2dc276e0f1630",
        "alias": "Lemon Silverfish",
        "aliasID": "65c289dced6eefce4cc219ab",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/38c081222540fbe548c41493c9650ae2.png",
        "created": "2020-08-11T11:54:45.784Z",
        "name": "Reimajo",
