      "spam": false,
      "statusChangeID": null,
      "value": "This should be the default behavior for persistent data IMO, security by default. Very surprising it's not like this already considering how much VRC says it cares about security. If they change the default this is something that needs to happen *now* and cannot be put off without a giant breaking change.",
      "viewerReactions": null,
      "voteID": null
    },
