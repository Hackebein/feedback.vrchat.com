      "statusChangeID": null,
      "value": "As of February 2023 avatar audio is currently completely removed on Quest. Just note for posterity.\n\nAs a PCVR user the only sounds I appreciate are short sounds attached to the person making them. Bonk bonk.",
      "viewerReactions": null,
      "voteID": null
    }
