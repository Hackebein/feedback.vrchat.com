      "statusChangeID": null,
      "value": "The introduction of stickers without giving World Creators effective control over their use adds unnecessary burden for both user-driven self-moderation and community management, which is less than ideal. Adding an SDK component seems like the perfect solution to address this!",
      "viewerReactions": null,
      "voteID": null
    }
