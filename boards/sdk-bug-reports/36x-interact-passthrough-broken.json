      "spam": false,
      "statusChangeID": null,
      "value": "The Interact Passthrough works if you set the layers to be Everything, but choosing to only set some specific layers to be passthrough just doesn't work. (Tested on SDK 3.7.4)",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "685cbac150a24d2a2806ae32",
      "aiGenerated": false,
      "author": {
        "_id": "60189fe37ae30b2338042f44",
        "alias": "Circular Marsupial",
        "aliasID": "65c297eded6eefce4ce58324",
