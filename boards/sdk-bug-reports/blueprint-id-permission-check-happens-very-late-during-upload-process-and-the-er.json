      "statusChangeID": null,
      "value": "I also found this very confusing with Unity 2022 -- I only saw this very generic error: ApiErrorException: Exception of type 'VRC.SDKBase.Editor.Api.ApiErrorException' was thrown.",
      "viewerReactions": null,
      "voteID": null
