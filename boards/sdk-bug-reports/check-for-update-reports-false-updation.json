      "mergeID": "63aac8460154d67b0b6eb972",
      "mergedPostDetails": "If you Check for Updates in the VRCSDK it says there's an update available, even when you're using the most up-to-date version. You can see in the attachment that I'm already using the latest version but it's telling me an there's an update. I'm not sure if this is a bug or the wording is just ambiguous but it's been confusing people, so it'd be nice to have a fix.",
      "mergedPostTitle": "SDK says there's an update when using latest version",
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "5cf678c5f300a805224b072c",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This is duplicate on https://vrchat.canny.io/bug-reports/p/check-for-update-reports-false-updation",
      "viewerReactions": null
    },
