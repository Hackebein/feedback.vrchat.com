      "statusChangeID": null,
      "value": "Hi @{5f611d53e2ad422996978ca6|full_name}! Thank you for your feedback.\n\nAre you familiar with the \"user templates\" feature? This allows you to set up a template project that you can easily reuse. Would this accomplish some of your goals?\n\nhttps://vcc.docs.vrchat.com/vpm/templates#user-templates",
      "viewerReactions": null,
      "voteID": null
    }
