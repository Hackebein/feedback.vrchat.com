        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5d09629c3511d825c8e56214",
      "companyID": "58c62e995865713647a7115d",
      "created": "2022-09-15T02:08:37.457Z",
      "deleted": false,
