      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I'm running into this issue with just one or two clients. Not sure why the offline testing client needs to authenticate anyway except for creator economy stuff anyway",
      "viewerReactions": null,
      "voteID": null
    },
