      "statusChangeID": null,
      "value": "Today I was uploading av avatar on a new ID and it took 4 tries to upload the Quest version.\n\nOn 2 of those tries it said \"Upload succeeded !\" even though it did not upload the Quest version.\n\n4th try went OK and it uploaded the Quest version.",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "65e0f1ceb59603c005a7722f",
      "aiGenerated": false,
      "author": {
        "_id": "6076f5edb4d0a10cea21aecd",
        "alias": "Ebony Orca",
        "aliasID": "65c29c1bed6eefce4c7daa4b",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/2a07272804a9a9f8d7f2c89d0f58347d.png",
        "created": "2021-04-14T14:02:21.703Z",
        "name": "Fuuujin",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5d09629c3511d825c8e56214",
      "companyID": "58c62e995865713647a7115d",
      "created": "2024-02-29T21:06:22.669Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
