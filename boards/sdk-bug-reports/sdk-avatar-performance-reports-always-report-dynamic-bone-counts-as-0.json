      "mergedPostDetails": "For some reason.",
      "mergedPostTitle": "Editor's dynamic bone counts are always zero if you use the version from the asset store.",
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "5c1d6c3cda15584535273b47",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "AvatarPerformance.cs FindDynamicBoneTypes() uses reflection to lookup the type for \"DynamicBoneCollider\". If null, it should check for a type named \"DynamicBoneColliderBase\" to work for the newer version of DynamicBone from the asset store.",
      "viewerReactions": null
    },
