      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This was fixed in a recent SDK update. The bug was that custom FX masks were not being correctly uploaded. You should now be able to author animations in the Gesture Layer, and use the FX layer mask to enable only the game objects that have actual FX animations on them (eg. material swaps, particle effects). Note that this means you can't have both a non-human bone or humanoid bone that also has a material or particle system that is animated directly on it, it'll need a child object. Details are in the FX Layer section of https://docs.vrchat.com/docs/playable-layers.",
      "viewerReactions": null,
      "voteID": null
    },
