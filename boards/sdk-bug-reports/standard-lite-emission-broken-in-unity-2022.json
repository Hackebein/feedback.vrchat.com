      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I know it's gonna be available in a future release, but we've seen two SDK updates since it got marked for future release and it's still not fixed. I just figured out how to fix this problem manually. \n\nI had to open the material file in Notepad++ and change 'EnableEmission' on line 69 or 70, from 0 to 1. That's the only way I found to keep the emission enabled.",
      "viewerReactions": null,
      "voteID": null
