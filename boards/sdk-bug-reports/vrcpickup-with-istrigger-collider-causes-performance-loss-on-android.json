        "aliasID": "65c38bdaed6eefce4c176796",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/f15facd4c9c911e2925b68af5203aed6.png",
        "created": "2018-04-25T18:58:49.462Z",
