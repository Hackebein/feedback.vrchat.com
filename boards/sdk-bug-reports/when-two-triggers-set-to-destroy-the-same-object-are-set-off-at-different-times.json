      "authorID": null,
      "boardID": "5d09629c3511d825c8e56214",
      "companyID": "58c62e995865713647a7115d",
      "created": "2018-08-01T08:07:02.016Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
