      "statusChangeID": null,
      "value": "I'm not sure why this was changed, the contextual \"Build and reload\" when clients = 0 was way better, it required fewer clicks. I don't ever need to launch >0 clients while reloading (that's kinda the entire point of reloading)",
      "viewerReactions": null,
      "voteID": null
    }
