      "spam": false,
      "statusChangeID": null,
      "value": "This issue similarly happens when Instantiating and Destroying objects with Udon. The memory used to hold or destroy those objects does not get cleared when leaving the world but does eventually get cleared, probably from garbage collection.",
      "viewerReactions": null,
      "voteID": null
