        "urlName": "megalon"
      },
      "authorID": null,
      "boardID": "5df404cc2072644ac4b5e385",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-04-09T02:58:03.937Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [
        "https://canny.io/images/5d2eb0aed4da6a890f23c068a9a7f7bd.png"
      ],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
      "parentID": null,
      "pinned": false,
      "postDeleted": false,
      "postID": "624c6d0ffb14875d5f3ae068",
      "private": false,
      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "It seems the problem is that JsonUtility cannot serialize / deserialize Vector2Int or Vector3Int, and there is no special case for them in Udon's Serialization system, so they always default to zero.\n\nJsonUtility is called within VRC.Udon.Serialization.SerializableObjectContainer\n\nYou can test this yourself with a small script:\n\n```\n\nDebug.Log(\"Test JsonUtility.ToJson\");\n\nstring jsonV2 = JsonUtility.ToJson(new Vector2(1f, 2f));\n\nstring jsonV3 = JsonUtility.ToJson(new Vector3(1f, 2f, 3f));\n\nstring jsonV2Int = JsonUtility.ToJson(new Vector2Int(1, 2));\n\nstring jsonV3Int = JsonUtility.ToJson(new Vector3Int(1, 2, 3));\n\nDebug.Log(jsonV2);\n\nDebug.Log(jsonV3);\n\nDebug.Log(jsonV2Int);\n\nDebug.Log(jsonV3Int);\n\nDebug.Log(\"Test JsonUtility.FromJson\");\n\nDebug.Log(JsonUtility.FromJson<Vector2>(jsonV2));\n\nDebug.Log(JsonUtility.FromJson<Vector3>(jsonV3));\n\nDebug.Log(JsonUtility.FromJson<Vector2Int>(jsonV2Int));\n\nDebug.Log(JsonUtility.FromJson<Vector3Int>(jsonV3Int));\n\n```\n\nEdit: typo",
      "viewerReactions": null,
      "voteID": null
    }
  ],
  "companyID": "58c62e995865713647a7115d",
