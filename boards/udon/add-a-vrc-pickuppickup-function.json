      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "duplicating this: https://feedback.vrchat.com/udon/p/add-a-vrc-pickuppickup-function",
      "viewerReactions": null,
      "voteID": null
    },
