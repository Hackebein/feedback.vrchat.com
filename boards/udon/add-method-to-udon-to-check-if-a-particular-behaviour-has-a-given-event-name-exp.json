      "statusChangeID": null,
      "value": "@{5a7ac88bf5a5c52c08064fb9|full_name}: That's basically what this use case is for. I want an event publisher to be able to auto-detect which events are defined on a given subscriber so I can cache that info and only trigger what's needed.",
      "viewerReactions": null
    }
