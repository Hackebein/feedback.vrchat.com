      "spam": false,
      "statusChangeID": null,
      "value": "The only issue is, as far as I am aware, at present the Unity UI Toolkit does not support world-space UIs officially.",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "687d505862ef6f64a9c9652f",
      "aiGenerated": false,
      "author": {
