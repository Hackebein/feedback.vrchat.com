        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "5df404cc2072644ac4b5e385",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-07-20T20:23:52.265Z",
      "deleted": false,
