      "internal": false,
      "mergeID": "6a7b0320f9961f60607f5bc8",
      "mergedPostDetails": "Imagine wearable props - currently props when clicked are linked to our hand bone, if possible can we be given an option of being able to choose a bone we want the prop to be attached to when creating a world? Detected bones in the rigging system will give us the available bones. Head for hats, chest for costume, forearm for shield, etc. All of this can be adjusted by the creator of a world for thier world.",
      "mergedPostTitle": "Allow PickupProps to link to certain bones",
      "pinned": false,
      "postID": "5ecbd5aae3b7743d83d7820d",
      "private": false,
      "spam": false,
      "synthetic": true,
      "value": ""
