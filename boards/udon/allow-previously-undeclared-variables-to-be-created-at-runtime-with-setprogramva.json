      "spam": false,
      "statusChangeID": null,
      "value": "@{5fcb7b66e537ea37806db719|full_name}: Using a dictionary would mean that external behaviours would have to be aware of your behaviour's implementation details in order to set an arbitrary variable.  Get/SetProgramVariable already provides a key/value pair API that is type agnostic and is a common API between all UdonBehaviours.",
      "viewerReactions": null
    }
