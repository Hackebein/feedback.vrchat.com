      "statusChangeID": null,
      "value": "Other notes:\n- default this feature off in the SDK; creators should only hit users with prompts if they know they need it\n- the prompt should not appear if settings are already in alignment with world requests\n- the volume slider should have a \"tolerance\" range that won't prompt so long as user's setting is near enough to requested\n- volume slider request should let the world creator specify \"at least\" and/or \"at most\"",
      "viewerReactions": null,
      "voteID": null
    },
    {
      "__v": 0,
      "_id": "632de41bb2416c44c3b17592",
      "author": {
