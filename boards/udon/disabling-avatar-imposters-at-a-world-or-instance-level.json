      "statusChangeID": null,
      "value": "Please consider this! Imposters can flicker rapidly due to their rendering issues, causing worlds that normally would not affect people with photosensitive epilepsy, to become problematic.  :(",
      "viewerReactions": null,
      "voteID": null
    }
