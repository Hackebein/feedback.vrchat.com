      "author": {
        "_id": "5de9405aea7cc52772fcc359",
        "alias": "Robust Crow",
        "aliasID": "65c27d11ed6eefce4cc8dee3",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/3832aa8915d09f633a5ab11ddec4d91f.jpg",
