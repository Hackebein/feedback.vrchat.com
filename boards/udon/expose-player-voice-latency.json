      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "An API for this purpose that takes into account all the of the factors impacting voice latency would be great. Some conversation I saw indicates other methods can be impacted by networking/throttling/culling factors that do not impact voice.\n\n The more precise this API is, the better.",
      "viewerReactions": null,
      "voteID": null
    },
