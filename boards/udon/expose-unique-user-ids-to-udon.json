      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I've honestly been hoping for a feature like this for years.  The few times I've changed my display name has caused major havoc for all the venues I perform at.  Having to manually contact each of the world owners and have them update their whitelists is tedious at best.",
      "viewerReactions": null,
      "voteID": null
