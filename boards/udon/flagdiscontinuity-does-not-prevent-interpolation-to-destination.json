      "statusChangeID": null,
      "value": "Relevant U# code:\n    public override void Interact()\n    {\n        for (int i = 1; i < spawns.Length; i++)\n        {\n            int swapIndex = Random.Range(0, i + 1);\n            if (swapIndex != i)\n            {\n                Vector3 tmp = spawns[i];\n                spawns[i] = spawns[swapIndex];\n                spawns[swapIndex] = tmp;\n            }\n        }\n        var localPlayer = Networking.LocalPlayer;\n        for (int i = 0; i < spawns.Length; i++)\n        {\n            Networking.SetOwner(localPlayer, objects[i].gameObject);\n            objects[i].transform.position = spawns[i];\n            objects[i].transform.rotation = Quaternion.identity;\n            objects[i].FlagDiscontinuity();\n        }\n    }",
