      "restoredAt": null,
      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Just encountered this and it was very surprising, can't say whether it should technically be the case or not, but it doesn't feel good. I feel that if I expected disabled gameobjects to receive input events, I'd be polling them in some central spot and passing them out myself\n\nAccounting for the gameobject being disabled in hierarchy in all code that uses VRC's input events isn't very intuitive",
      "viewerReactions": null,
      "voteID": null
