      "statusChangeID": null,
      "value": "Bumping this for Udon and avatar purposes alike.  Please whitelist LPPV for avatars so there's decent options in probe-dense high-fidelity maps to better support complex character lighting.",
      "viewerReactions": null,
      "voteID": null
    }
