    {
      "__v": 0,
      "_id": "63b377f2f762cd402922ebb8",
      "author": {
        "_id": "6222c8bd759f2e2d1462eca6",
        "alias": "Unlikely Trout",
        "aliasID": "65c29c85ed6eefce4c8cc762",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/5057f88de91b205dd5a58c43fa7c89d0.png",
        "created": "2022-03-05T02:19:41.933Z",
        "name": "aurycat",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5df404cc2072644ac4b5e385",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-01-03T00:33:54.664Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
