  "details": "SDK `3.10.5`\n\nSee below code, it outputs \"false, true, true\" (and vice versa) which is obviously wrong.\n\nHowever if the property is `public` it outputs \"true, true, true\" as expected.\n\n```\n\nusing UdonSharp;\n\nusing UnityEngine;\n\n[UdonBehaviourSyncMode(BehaviourSyncMode.None)]\n\npublic class WhyPropertyNoWork : UdonSharpBehaviour\n\n{\n\n    private int state;\n\n    private const int TestState = 3;\n\n    private bool IsTestState\n\n    {\n\n        get { return state == TestState; }\n\n        set { }\n\n    }\n\n    private WhyPropertyNoWork _whyThis;\n\n    private void Start()\n\n    {\n\n        state = TestState;\n\n        _whyThis = this;\n\n    }\n\n    public override void Interact()\n\n    {\n\n        Debug.Log(\n\n            $\"TESTTEST, _whyThis.IsTestState={_whyThis.IsTestState}, IsTestState={IsTestState}, _whyThis.IsTestState={_whyThis.IsTestState}\");\n\n        if (state == 3)\n\n            state = 0;\n\n        else\n\n            state = TestState;\n\n    }\n\n}\n\n```",
