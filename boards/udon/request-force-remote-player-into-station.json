      },
      "authorID": null,
      "boardID": "5df404cc2072644ac4b5e385",
      "companyID": "58c62e995865713647a7115d",
      "created": "2025-08-16T09:31:41.091Z",
      "deleted": false,
      "deletedAt": null,
      "fileURLs": [],
      "files": [],
