      "statusChangeNewStatus": "closed",
      "value": "This is undefined behavior and I don't expect it to change. Giving away ownership at the same time as changing a variable is always going to be a race condition and there's nothing that VRChat can do about it without adding in multiple extra round trips to confirm the transfer.",
      "viewerReactions": null,
      "voteID": null
    }
