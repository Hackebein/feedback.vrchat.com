      "_id": "64f76aeed7da9c249d1410d0",
      "author": {
        "_id": "5f2d204b74493130abcdca6e",
        "alias": "Happy Jellyfish",
        "aliasID": "65c27b0eed6eefce4c7d1c4c",
        "anonymized": false,
        "avatarURL": "https://canny-assets.io/images/e865a419b452d452db17b2330d5bddf4.png",
        "created": "2020-08-07T09:35:07.038Z",
        "name": "Haï~",
        "serviceAccount": false,
        "urlName": "<redacted>"
      },
      "authorID": null,
      "boardID": "5df404cc2072644ac4b5e385",
      "companyID": "58c62e995865713647a7115d",
      "created": "2023-09-05T17:52:46.600Z",
      "deleted": false,
      "fileURLs": [],
      "files": [],
      "imageURLs": [],
      "integrationSourceType": null,
      "internal": false,
      "itemSourceType": null,
      "mentionedUserIDs": null,
      "mentionedUsers": [],
      "mergeID": null,
