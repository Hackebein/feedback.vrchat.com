    {
      "__v": 0,
      "_id": "5f0f3c24dfb39274cd7565ae",
      "author": {
        "_id": "5f0f37e7f28e74047f4179c6",
        "alias": "Devoted Iguana",
        "aliasID": "65f0c6b1a6e3ea79dd8c55dd",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/ccc0c20df4fdfe7f7c0a23297f172b90.png",
        "created": "2020-07-15T17:07:51.157Z",
