      },
      "authorID": null,
      "boardID": "5df404cc2072644ac4b5e385",
      "companyID": "58c62e995865713647a7115d",
      "created": "2020-07-15T17:25:56.621Z",
      "deleted": false,
      "fileURLs": [],
