      "statusChangeID": null,
      "value": "This will happen since you still play the walking animations under the hood when the force locomotion for 6 PT is tick off in the avatar descriptor and don't customize the base controller.\n\nJust use the option in the quick menu instead that was added to turn off the walking in FBT.\n\n@{6161a61a2c0de966b4e43486|full_name}",
      "viewerReactions": null,
      "voteID": null
