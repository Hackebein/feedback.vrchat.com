      "reactions": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Personally I love height scale and I'm never going back to armspan. I've always hated how with the later I could not fully stretch my arms be it 3 or 6 point tracking",
      "viewerReactions": null
    }
