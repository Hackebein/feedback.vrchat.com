      "statusChangeID": null,
      "value": "Opening the overlay should still trigger the AFK state, so if you'd like tracking to disable you can use the AFK state in your animator to set your avatar's tracking control to animated to prevent tracking data from being applied.",
      "viewerReactions": null,
      "voteID": null
