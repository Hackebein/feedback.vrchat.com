      "private": false,
      "reactions": {
        "like": 3
      },
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "Its way too expensive considering all it does is give you a profile pic (I cant believe something as simple as that is a premium feature) and additional avatar slots for 120$ a year. Its marketing currently walks this weird middle ground between \"support us a creators\" and \"this is the premium aspect of our service\". if you want to make VRC+ a donation thing then stop locking essential features behind it and if you want to make it a premium sub then either put more actual features in it or lower the price. is this company incapable of doing anything right?",
      "viewerReactions": null
    }
