      "statusChangeID": null,
      "value": "A few of my thoughts:\n- World/avatar contests with monetary prizes to support the world/avatar-building community\n- Someone mentioned named, persistent public instances; potentially reachable with a custom URL.\n- Additional World and avatar favorites slots\n- The ability to submit worlds without going through Community Labs",
      "viewerReactions": null
    },
    {
      "__v": 0,
      "_id": "5fb9a0fec233f4063eb40747",
      "author": {
        "_id": "5fb8205b31fddc2396742d8b",
        "alias": "Neon blue Armadillo",
        "aliasID": "68eeb981d5830af7f1211fd7",
        "anonymized": false,
        "avatarURL": "https://canny.io/images/cc7b7e9dbf5602d6756f6f5e2e7ec51d.png",
        "created": "2020-11-20T20:00:27.436Z",
        "name": "Bexi",
        "serviceAccount": false,
        "urlName": null
      },
      "authorID": null,
      "boardID": "5fb73025b60a5b530ef43009",
      "companyID": "58c62e995865713647a7115d",
      "created": "2020-11-21T23:21:34.168Z",
      "deleted": false,
      "fileURLs": [],
