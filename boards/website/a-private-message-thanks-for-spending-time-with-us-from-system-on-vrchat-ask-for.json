      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "I think the easiest thing to do would be to rename the user that the messages come from, instead of from \"system\", which kinda indicates that its from VRChat the service, not some third party forum software.\n\nIf the messages came from \"VRChat Ask Forum\" instead of \"system\" there would be no ambiguity.",
      "viewerReactions": null,
      "voteID": null
    }
