      "statusChangeID": null,
      "value": "For anyone with tampermonkey, this userscript fixes the issue temporarily.\n\n```\n\n// ==UserScript==\n\n// @name         Fix broken vrchat groups\n\n// @version      0.1\n\n// @description  Yes\n\n// @match        https://vrchat.com/*\n\n// @run-at       document-start\n\n// @grant        unsafeWindow\n\n// ==/UserScript==\n\n(function() {\n\n    'use strict';\n\n    const originalFetch = unsafeWindow.fetch;\n\n    unsafeWindow.fetch = async (...args) => {\n\n        let res = await originalFetch(...args);\n\n        function patchJson(data) {\n\n            if (data.myMember && data.myMember.roleIds && data.roles) {\n\n                data.myMember.roleIds = data.myMember.roleIds.filter(roleId => data.roles.some(role => role.id == roleId));\n\n            }\n\n            return data;\n\n        }\n\n        const oldJson = res.json.bind(res);\n\n        res.json = () => oldJson().then(patchJson);\n\n        if (res.headers.get('Content-Type').includes('application/json')) {\n\n            const oldText = res.text.bind(res);\n\n            res.text = () => oldText().then((data) => {\n\n                return JSON.stringify(patchJson(JSON.parse(data)))\n\n            });\n\n        }\n\n        return res;\n\n    };\n\n})();\n\n```",
