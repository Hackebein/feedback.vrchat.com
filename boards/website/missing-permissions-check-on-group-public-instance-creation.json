      "sourceFeatureExtractionItemID": null,
      "sourceLink": null,
      "spam": false,
      "statusChangeID": null,
      "value": "This also works for group public instances, without being a member in that group (with create instances permissions removed from members & everyone). All one needs is a group ID and a world ID; group public links are unlocked. For clarification, [a shortname](https://feedback.vrchat.com/bug-reports/p/invite-link-not-works-on-non-intance-creator) isn't required, because an unlocked invite link can be manually constructed (without a nonce or a shortlink).",
      "viewerReactions": null,
      "voteID": null
    },
