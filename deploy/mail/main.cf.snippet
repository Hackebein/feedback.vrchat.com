# Merged by install_mail_on_server.sh — inbound-only for one recipient.
myhostname = mx.vrchat-canny.hackebein.dev
mydomain = vrchat-canny.hackebein.dev
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination =
local_recipient_maps =
relayhost =
relay_domains = $mydomain
virtual_alias_domains =
virtual_alias_maps =
transport_maps = hash:/etc/postfix/transport_canny
smtpd_helo_required = yes
disable_vrfy_command = yes
message_size_limit = 10485760
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, check_recipient_access hash:/etc/postfix/recipient_access, reject
