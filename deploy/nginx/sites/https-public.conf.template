server {
    listen 443 ssl http2;
    server_name @FEEDBACK_PUBLIC_DOMAIN@;

    ssl_certificate /etc/ssl/cloudflare/origin/cert.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;

    # Strip OpenSearch-injected response headers that fingerprint the upstream.
    proxy_hide_header X-Opaque-Id;
    proxy_hide_header X-Elastic-Product;
    proxy_hide_header X-Opensearch-Product;
    proxy_hide_header X-Opensearch-Version;

    client_max_body_size 25m;

    # Public CORS (any origin). OPTIONS short-circuit — OpenSearch often 405s preflight. 418 only used for this chain.
    error_page 418 =204 @vrchat_feedback_search_cors_preflight;
    if ($request_method = OPTIONS) {
        return 418;
    }

    proxy_http_version   1.1;
    proxy_connect_timeout 15s;
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;

    location @vrchat_feedback_search_cors_preflight {
        default_type text/plain;
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
    }

    location = / {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        default_type text/html;
        charset utf-8;
        alias /var/www/vrchat-feedback-search/scalar-api-reference.html;
    }

    location = /openapi.json {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        alias /var/www/vrchat-feedback-search/openapi.json;
        default_type application/json;
        charset utf-8;
    }

    location = /_mapping {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET {
            deny all;
        }
        limit_conn os_search_parallel 10;
        limit_conn_status 429;
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/feedback-posts/_mapping$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /_count {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET POST {
            deny all;
        }
        limit_conn os_search_parallel 10;
        limit_conn_status 429;
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/feedback-posts/_count$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /_field_caps {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET POST {
            deny all;
        }
        limit_conn os_search_parallel 10;
        limit_conn_status 429;
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/feedback-posts/_field_caps$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/_doc/([^/]+)$ {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET HEAD {
            deny all;
        }
        limit_conn os_search_parallel 10;
        limit_conn_status 429;
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/feedback-posts/_doc/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/_source/([^/]+)$ {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET HEAD {
            deny all;
        }
        limit_conn os_search_parallel 10;
        limit_conn_status 429;
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/feedback-posts/_source/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /_search {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET POST {
            deny all;
        }
        limit_conn os_search_parallel 6;
        limit_conn_status 429;
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/feedback-posts/_search$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        include /etc/nginx/conf.d/vrchat-feedback-search-proxy-extra.inc;
        include /etc/nginx/conf.d/feedback-search-upstream-auth.inc;
        limit_except GET {
            deny all;
        }
        limit_req zone=os_search_rps burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:9200/_cluster/health$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        include /etc/nginx/conf.d/vrchat-feedback-search-cors.inc;
        # Not on the public allowlist — do not use 404 (clients may confuse with OpenSearch "not found").
        return 403;
    }
}

server {
    listen 80;
    server_name @FEEDBACK_PUBLIC_DOMAIN@;
    return 301 https://$host$request_uri;
}
