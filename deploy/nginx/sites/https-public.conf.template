server {
    listen 443 ssl http2;
    server_name @FEEDBACK_PUBLIC_DOMAIN@;

    ssl_certificate /etc/ssl/cloudflare/origin/cert.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 25m;

    # OPTIONS preflight handled here so optional complex clients always see CORS answers.
    error_page 418 =204 @feedback_search_options;
    if ($request_method = OPTIONS) {
        return 418;
    }

    proxy_http_version   1.1;
    proxy_connect_timeout 15s;
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;

    location @feedback_search_options {
        default_type text/plain;
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
    }

    # Hits the Node gateway (not the SPA). A 502 here means nginx cannot reach 127.0.0.1:3333.
    location = /healthz {
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        include /etc/nginx/conf.d/feedback-search-http-proxy-defaults.inc;
        proxy_pass http://feedback_search_gateway/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # Notification API (Web Push subscriptions + webhooks). Longer prefix than
    # /api/ so these requests reach the Go dispatcher, not the search gateway.
    location ^~ /api/notify/ {
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        include /etc/nginx/conf.d/feedback-search-http-proxy-defaults.inc;
        proxy_pass http://feedback_notify;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location ^~ /api/ {
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        include /etc/nginx/conf.d/feedback-search-http-proxy-defaults.inc;
        proxy_pass http://feedback_search_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location = /openapi.json {
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        alias /var/www/feedback-search/openapi.json;
        default_type application/json;
        charset utf-8;
    }

    location = / {
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        root /var/www/feedback-search;
        try_files /index.html =404;
    }

    location / {
        include /etc/nginx/conf.d/feedback-search-public-cors.inc;
        root /var/www/feedback-search;
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name @FEEDBACK_PUBLIC_DOMAIN@;
    return 301 https://$host$request_uri;
}
