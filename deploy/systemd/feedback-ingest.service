[Unit]
Description=VRChat feedback ingest (git ff-only, compose/openapi/nginx sync, OpenSearch bulk)
After=docker.service network-online.target network.target

[Service]
Type=oneshot
# Generated by deploy/scripts/bootstrap_security.sh; contains OPENSEARCH_USER,
# OPENSEARCH_PASSWORD, OPENSEARCH_URL, FEEDBACK_REPO_ROOT, FORCE_REINDEX.
EnvironmentFile=/etc/feedback-search/ingest.env
WorkingDirectory=/srv/feedback.vrchat.com
ExecStart=/bin/bash deploy/scripts/git_pull_reindex.sh
