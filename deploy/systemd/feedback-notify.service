[Unit]
Description=VRChat feedback notification dispatcher
After=network-online.target docker.service feedback-search-gateway.service
Wants=network-online.target

[Service]
Type=simple
# Generated by deploy/scripts/bootstrap_security.sh; contains GATEWAY_URL,
# INDEX_NAME, NOTIFY_BIND/PORT, and the VAPID keypair.
EnvironmentFile=/etc/feedback-search/notify.env
ExecStart=/opt/feedback-notify/feedback-notify
StateDirectory=feedback-notify
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
