[Unit]
Description=VRChat feedback search gateway (HTTPS /api goes to localhost SearchKit to OpenSearch)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/feedback-search/gateway.env
WorkingDirectory=@FEEDBACK_REPO_ROOT@/search-ui
ExecStart=/usr/bin/node dist/server.cjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
