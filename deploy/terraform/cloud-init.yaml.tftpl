#cloud-config
package_update: true
package_upgrade: true

write_files:
  - path: /etc/sysctl.d/99-feedback-opensearch-vm.conf
    content: |
      vm.max_map_count = 262144
    permissions: "0644"

runcmd:
  - [sysctl, --system]
  - |
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y docker.io docker-compose-v2 git python3-venv
  - [systemctl, enable, --now, docker]
  - |
    set -eux
    install -d /srv
    if [ ! -d '/srv/feedback.vrchat.com/.git' ]; then
      git clone --depth 1 '${repo_url}' /srv/feedback.vrchat.com
    fi
  - |
    set -eux
    cd /srv/feedback.vrchat.com
    docker compose -f deploy/docker-compose.yml up -d
%{ if enable_public_https ~}
  - |
    set -eux
    bash /srv/feedback.vrchat.com/deploy/scripts/bootstrap_https_on_server.sh
%{ endif ~}
